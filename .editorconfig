root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,resx}]
indent_size = 2

[*.cs]
# 文件级 namespace（违反即编译错误）
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

# using 指令置于 namespace 之外
csharp_using_directive_placement = outside_namespace:warning

# 语言风格
csharp_prefer_braces = true:warning
csharp_style_var_elsewhere = false:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
# 只在初始化或构造函数里赋过值的私有字段必须是 readonly。
# 提到 warning 是为了让 VS 和 CI 得出同一个结论，而不是只在某一边冒出来。
dotnet_diagnostic.IDE0044.severity = warning

# 集合表达式（[...] 代替 new[] {...}）：不强制。
# 现有写法读起来没有问题，为统一风格全仓改一遍只会制造噪音提交。
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0302.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_sort_system_directives_first = true

# 命名：接口以 I 开头
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefixed_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefixed_with_i.required_prefix = I
dotnet_naming_style.prefixed_with_i.capitalization = pascal_case

[tests/**/*.cs]
# 测试项目允许不加文档、允许下划线命名的测试方法
dotnet_diagnostic.CA1707.severity = none
