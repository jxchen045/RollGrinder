<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RollGrinder.Integration.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RollGrinder.Composition\RollGrinder.Composition.csproj" />
    <ProjectReference Include="..\..\src\RollGrinder.Core\RollGrinder.Core.csproj" />
    <ProjectReference Include="..\..\src\RollGrinder.Sim\RollGrinder.Sim.csproj" />
    <ProjectReference Include="..\..\src\RollGrinder.Services\RollGrinder.Services.csproj" />
    <ProjectReference Include="..\..\src\RollGrinder.Data\RollGrinder.Data.csproj" />
    <ProjectReference Include="..\..\src\RollGrinder.Device\RollGrinder.Device.csproj" />
    <ProjectReference Include="..\..\src\RollGrinder.Contracts\RollGrinder.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 导航状态机是纯逻辑（不引用 WPF），链接进来直接测：
         App 是 net8.0-windows 目标，测试工程不能引用它。 -->
    <Compile Include="..\..\src\RollGrinder.App\Navigation\PageKey.cs" Link="Navigation\PageKey.cs" />
    <Compile Include="..\..\src\RollGrinder.App\Navigation\NavigationModel.cs" Link="Navigation\NavigationModel.cs" />
    <Compile Include="..\..\src\RollGrinder.App\Navigation\AreaMenuLayout.cs" Link="Navigation\AreaMenuLayout.cs" />
    <Compile Include="..\..\src\RollGrinder.App\Diagnostics\ExceptionStormDetector.cs" Link="Diagnostics\ExceptionStormDetector.cs" />
    <Compile Include="..\..\src\RollGrinder.App\SelfTest\SelfTestOptions.cs" Link="SelfTest\SelfTestOptions.cs" />
    <Compile Include="..\..\src\RollGrinder.App\SelfTest\SelfTestRecorder.cs" Link="SelfTest\SelfTestRecorder.cs" />
    <Compile Include="..\..\src\RollGrinder.App\Controls\ContrastMath.cs" Link="Controls\ContrastMath.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
