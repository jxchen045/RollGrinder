<UserControl x:Class="RollGrinder.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        辊形库 / 程序库（界面修订稿 v3 6.5.2、6.6.2）。左：条目（版本、在用支数，停用的灰显排在后面）；
        右上：预览（辊形画曲线，程序写适用类型、标准余量、工序）；右下：在用清单，或"版本记录"时的留档各版。
        点一行选中，长按 0.6 秒或"打开"到编辑页。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{ctl:Px 720}" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{ctl:Px 90}" />
                        <ColumnDefinition Width="{ctl:Px 280}" />
                        <ColumnDefinition Width="{ctl:Px 80}" />
                        <ColumnDefinition Width="{ctl:Px 180}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Lib_ColName}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc Lib_ColVersion}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc Lib_ColDetail}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="3" Text="{loc:Loc Lib_ColUsers}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{loc:Loc Lib_ColModified}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                </Grid>
                <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0"
                         Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.PanningMode="VerticalOnly">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="56" Padding="12,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1"
                                    Background="Transparent"
                                    ctl:TouchInput.LongPressCommand="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{x:Static ctl:LayoutProfile.LibraryVersionColumn}" />
                                        <ColumnDefinition Width="{x:Static ctl:LayoutProfile.LibraryDetailColumn}" />
                                        <ColumnDefinition Width="{x:Static ctl:LayoutProfile.LibraryUsersColumn}" />
                                        <ColumnDefinition Width="{x:Static ctl:LayoutProfile.LibraryModifiedColumn}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontFamily="{StaticResource Font.Mono}"
                                               Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Text.Label}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding UsersText}" FontFamily="{StaticResource Font.Mono}"
                                               Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontFamily="{StaticResource Font.Mono}"
                                               Style="{StaticResource Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                                    <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Lib_PreviewHeader}" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding SelectedEntry.Name}" Style="{StaticResource Text.CardTitle}" FontWeight="Bold" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding SelectedEntry.VersionText}" Style="{StaticResource Text.CardTitle}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding PreviewRows}" Margin="14,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <plot:WpfPlot x:Name="PreviewPlot" Margin="6"
                                  Visibility="{Binding IsProfiles, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{Binding LowerTitle}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource DataTable}" HeadersVisibility="Column"
                                  Visibility="{Binding ShowingVersions, Converter={StaticResource InverseBoolVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Ledger_Code}" Binding="{Binding RollId}" Width="1.4*" />
                                <DataGridTextColumn Header="{loc:Loc Ledger_Purpose}" Binding="{Binding Purpose}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Ledger_CurrentDiameter}" Binding="{Binding CurrentText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource DataTable}" HeadersVisibility="Column"
                                  Visibility="{Binding ShowingVersions, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Lib_ColVersion}" Binding="{Binding VersionText}" Width="0.6*" />
                                <DataGridTextColumn Header="{loc:Loc Lib_ColReplacedAt}" Binding="{Binding SavedText}" Width="1.4*" />
                                <DataGridTextColumn Header="{loc:Loc Lib_ColReplacedBy}" Binding="{Binding SavedBy}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 复制、重命名、另存为新的命名框（3 种弹出框之一）。 -->
        <views:NamePromptOverlay Grid.ColumnSpan="2" DataContext="{Binding NamePrompt}" />
    </Grid>
</UserControl>
