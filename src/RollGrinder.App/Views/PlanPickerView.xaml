<UserControl x:Class="RollGrinder.App.Views.PlanPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        选辊形 / 选程序子视图（界面修订稿 v3 4.2）：左边已按这支辊过滤的库（长度 2% 规则、适用类型、停用的不列），
        右边是选中那一条——辊形与现计划叠图（实线选中、虚线现计划），程序列要点。DataContext 是 PlanPickerViewModel。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{ctl:Px 640}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,6,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0"
                         Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.PanningMode="VerticalOnly">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="56" Padding="12,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1" Background="Transparent">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontFamily="{StaticResource Font.Mono}"
                                               Style="{StaticResource Text.Body}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Fits}" Value="False">
                                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Picker_Current}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding CurrentName}" Style="{StaticResource Text.CardTitle}" Margin="8,0,24,0" />
                        <TextBlock Text="{loc:Loc Picker_Selected}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource Text.CardTitle}" FontWeight="Bold" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ProgramRows}" Margin="14,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <plot:WpfPlot x:Name="Plot" Margin="6" Visibility="{Binding IsProfile, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
