<UserControl x:Class="RollGrinder.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls">
    <!--
        诊断区（界面最终稿 5.12）：横键 报警 · 变量监视 · 改动记录 · 运行日志 · 空 · 连接与接口 · 备份与恢复，
        一次只摆当前组的窗。机床配置、标签映射的编辑在调试区。
    -->
    <Grid>
        <!-- 报警：左表右详情；底下写三类报警各用什么键消。 -->
        <Grid Visibility="{Binding Group, Converter={StaticResource EqualsToVisibility}, ConverterParameter=alarms}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{ctl:Px 520}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center"
                                       Text="{Binding Events.Count, StringFormat={}{0}}" />
                            <TextBlock Text="{loc:Loc Diag_EventsHeader}" Style="{StaticResource Text.CardTitle}" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="14,10">
                        <TextBlock Text="{Binding AlarmRangeNoteText}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                    </Border>
                    <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedAlarm}" Style="{StaticResource DataTable}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Alarm_TimeColumn}" Binding="{Binding TimeText}" Width="{ctl:Px 220}" />
                            <DataGridTextColumn Header="{loc:Loc Diag_AlarmCodeColumn}" Binding="{Binding CodeText}" Width="{ctl:Px 120}" />
                            <DataGridTextColumn Header="{loc:Loc Alarm_MessageColumn}" Binding="{Binding Message}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Alarm_SeverityColumn}" Binding="{Binding SeverityText}" Width="{ctl:Px 110}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource Text.CardTitle}">
                            <Run Text="{Binding SelectedAlarm.CodeText, Mode=OneWay}" />
                            <Run Text="{loc:Loc Diag_AlarmDetailHeader}" />
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="16,12" Visibility="{Binding HasSelectedAlarm, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedAlarm.Message}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedAlarm.TimeText}" Style="{StaticResource Text.Label}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SelectedAlarm.SeverityText}" Style="{StaticResource Text.Label}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SelectedAlarm.Detail}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding SelectedAlarm.Detail, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Text="{loc:Loc Diag_AlarmResetLabel}" Style="{StaticResource Text.Label}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding AlarmResetText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 变量监视 -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Group, Converter={StaticResource EqualsToVisibility}, ConverterParameter=tagMonitor}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc Diag_TagMonitorTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.HeaderFill}" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{x:Static ctl:LayoutProfile.TagValueColumn}" />
                            <ColumnDefinition Width="{x:Static ctl:LayoutProfile.TagStateColumn}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Diag_TagMonitorKey}"
                                   Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc Diag_TagMonitorValue}"
                                   Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc Diag_TagMonitorQuality}"
                                   Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TagMonitorRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{x:Static ctl:LayoutProfile.TagValueColumn}" />
                                            <ColumnDefinition Width="{x:Static ctl:LayoutProfile.TagStateColumn}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                   Style="{StaticResource Text.DataRow}" Margin="16,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                   Style="{StaticResource Text.DataRow}" />
                                        <TextBlock Grid.Column="2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.DataRow}">
                                                    <Setter Property="Text" Value="{loc:Loc Diag_TagQualityBad}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.CurrentStep}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                            <Setter Property="Text" Value="{loc:Loc Diag_TagQualityGood}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Normal}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 改动记录：补偿设定、机床配置、标签映射、标定，每次改动一行 -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Group, Converter={StaticResource EqualsToVisibility}, ConverterParameter=audit}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc Diag_ChangeLogHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                        <DataGrid ItemsSource="{Binding ChangeLogRows}" Style="{StaticResource DataTable}" Margin="8"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="{StaticResource Size.Caption}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Comp_ColumnTime}" Binding="{Binding TimeText}" Width="1.3*" />
                                <DataGridTextColumn Header="{loc:Loc Diag_ChangeBy}" Binding="{Binding ByText}" Width="0.8*" />
                                <DataGridTextColumn Header="{loc:Loc Diag_ChangeArea}" Binding="{Binding AreaText}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Diag_ChangeItem}" Binding="{Binding Item}" Width="2*" />
                                <DataGridTextColumn Header="{loc:Loc Diag_ChangeOld}" Binding="{Binding OldText}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Diag_ChangeNew}" Binding="{Binding NewText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
            </DockPanel>
        </Border>

        <!-- 运行日志：只看末尾几百行 -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Group, Converter={StaticResource EqualsToVisibility}, ConverterParameter=runLog}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc Diag_InspectorHeader}" Style="{StaticResource Text.CardTitle}"
                               VerticalAlignment="Center" />
                </Border>
                <TextBox Text="{Binding InspectorText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}" Margin="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="{StaticResource Brush.Surface}"
                         TextWrapping="NoWrap" />
            </DockPanel>
        </Border>

        <!-- 连接与接口：连接、补偿接口、契约校验、降级、机床能力 -->
        <Grid Visibility="{Binding Group, Converter={StaticResource EqualsToVisibility}, ConverterParameter=connection}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{ctl:Px 520}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Diag_ConnectionHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding ConnectionRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataRowBorder}">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource Size.Body}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Body}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGood}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Normal}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.CurrentStep}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Diag_CompensationHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding CompensationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DataRowBorder}">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource Size.Body}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Body}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Diag_ContractHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel Margin="16,12">
                        <TextBlock Text="{Binding TagMapCheckText}" FontSize="{StaticResource Size.Body}" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.CurrentStep}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TagMapIsValid}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Normal}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding MissingTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}"
                                               Foreground="{StaticResource Brush.CurrentStep}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Diag_DegradationHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <UniformGrid Columns="3" Margin="12">
                        <Border Margin="4" Padding="16,12" Background="{StaticResource Brush.Accent}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Degradation_Full}" FontSize="{StaticResource Size.Body}" Foreground="{StaticResource Brush.OnAccent}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Degradation_FullDetail}" FontSize="{StaticResource Size.Caption}"
                                           Foreground="{StaticResource Brush.OnAccentMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="16,12" Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.ButtonBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Degradation_NoRealtime}" FontSize="{StaticResource Size.Body}" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Degradation_NoRealtimeDetail}" Style="{StaticResource Text.Label}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4" Padding="16,12" Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.ButtonBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Degradation_FeedForwardOnly}" FontSize="{StaticResource Size.Body}" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Degradation_FeedForwardOnlyDetail}" Style="{StaticResource Text.Label}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Diag_CapabilityHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Capabilities}" Background="{StaticResource Brush.GridLine}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ParameterCell}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="{StaticResource Size.Caption}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Size.Body}" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Normal}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- 备份与恢复：竖键 1 备份、2 导出故障快照。恢复是停机时把备份包解回 config/ 与 data/，不在运行中做。 -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Group, Converter={StaticResource EqualsToVisibility}, ConverterParameter=backup}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc Diag_BackupHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <StackPanel Margin="24,16" MaxWidth="{ctl:Px 1000}" HorizontalAlignment="Left">
                    <TextBlock Text="{loc:Loc Diag_BackupNote}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Diag_RestoreNote}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
