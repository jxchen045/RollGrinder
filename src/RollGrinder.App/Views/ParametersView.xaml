<UserControl x:Class="RollGrinder.App.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls">
    <Grid>
        <Grid.Resources>
            <!-- 换砂轮向导（竖键"换砂轮 ▸"）：开着时盖住本组内容，路径条显示"« 返回"。 -->
            <Style x:Key="WheelChangePanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_WheelChange">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 横键"砂轮"：三栏——砂轮数据、修整参数（简图）、修整与更换记录（最终稿 5.10）。 -->
            <Style x:Key="WheelPanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Group}" Value="wheel">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 每一步只露出这一步要填的东西：多摆几个空格子只会让人填错 -->
            <Style x:Key="WheelChangeEnterNewWheel" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WheelChangeStage}" Value="EnterNewWheel">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WheelChangeTrial" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WheelChangeStage}" Value="TrialGrind">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WheelChangeVerify" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WheelChangeStage}" Value="Verify">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- 横键"标定"：按部件分组，每组一个窗；参数格由 MachineCalibration.Schema 生成。 -->
        <Border Style="{StaticResource Card}"
                Visibility="{Binding IsCalibrationGroup, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding CalibrationGroups}" IsEnabled="{Binding CanEdit}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Rows}" Background="{StaticResource Brush.GridLine}"
                                                  ItemTemplate="{StaticResource ParameterCellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 横键"标定审计"：每一项最后是谁在什么时候改的。 -->
        <Border Style="{StaticResource Card}"
                Visibility="{Binding IsAuditGroup, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc Settings_AuditHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Settings_AuditEmpty}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Audit.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Audit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="56" Padding="16,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource Text.DataRow}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--
            换砂轮向导：改手动对刀 → 手动对刀试磨 → 按实测反推砂轮直径 → 改回原来的对刀方式。
            机床上的活由人做，这一页只记数、切对刀方式、算修正值。
        -->
        <Border Style="{StaticResource WheelChangePanel}" Panel.ZIndex="1">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc WheelChange_Header}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <!-- 下一步 / 这一刀不作数 / 放弃换砂轮… 在竖键 1 / 2 / 8。 -->
                <!-- 每一步配一张图，标出这一步要量、要填的是哪个尺寸（修改稿 5②）。 -->
                <ctl:WheelDiagram DockPanel.Dock="Right" Width="{ctl:Px 420}" Height="{ctl:Px 260}" Margin="0,20,24,0" VerticalAlignment="Top"
                                  Mode="{Binding WizardDiagramMode}" HighlightKey="{Binding WizardHighlightKey}" />

                <StackPanel Margin="24,20">
                    <TextBlock Text="{Binding WheelChangeHint}" Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,0,0,20" />

                    <StackPanel Style="{StaticResource WheelChangeEnterNewWheel}">
                        <TextBlock Text="{loc:Loc Parameter_newWheelDiameterMm}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding NewWheelDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="{ctl:Px 220}" HorizontalAlignment="Left"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource WheelChangeTrial}">
                        <TextBlock Text="{loc:Loc WheelChange_ExpectedDiameter}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TrialExpectedDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="{ctl:Px 220}" HorizontalAlignment="Left"
                                 Margin="0,6,0,16" />
                        <TextBlock Text="{loc:Loc WheelChange_MeasuredDiameter}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TrialMeasuredDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="{ctl:Px 220}" HorizontalAlignment="Left"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource WheelChangeVerify}">
                        <TextBlock Text="{Binding WheelChangeResultText}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource Size.DataRow}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock Text="{loc:Loc WheelChange_VerifyNote}" Style="{StaticResource Text.Label}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 砂轮：砂轮数据（简图）、修整参数（金刚笔简图）、修整与更换记录。参数格和标定值是同一批，按"保存"一起存。 -->
        <Border Style="{StaticResource WheelPanel}">
            <DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{ctl:Px 360}" />
                    </Grid.ColumnDefinitions>

                    <!-- 标题、简图、参数格、底部说明：简图那一行封顶 320，参数格紧跟其下；紧凑档位高度不够时先缩简图，参数格不被裁。 -->
                    <Grid Grid.Column="0" Margin="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MaxHeight="{ctl:Px 320}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{loc:Loc Wheel_DataHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ctl:WheelDiagram Grid.Row="1" Mode="Wheel" Margin="10"
                                          HighlightKey="{Binding FocusedWheelKey}" />
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding WheelRows}" Background="{StaticResource Brush.GridLine}"
                                      IsEnabled="{Binding CanEdit}" ItemTemplate="{StaticResource ParameterCellTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Grid.Row="3" Padding="14,10" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Settings_WheelWear}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding WheelWearText}" Style="{StaticResource Text.DataRow}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="{loc:Loc Wheel_MaxSurfaceSpeed}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding MaxSurfaceSpeedText}" Style="{StaticResource Text.DataRow}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MaxHeight="{ctl:Px 320}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Wheel_DressHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ctl:StepDiagram Grid.Row="1" StepTypeKey="WheelDress" Margin="10"
                                         HighlightedParameterKey="{Binding FocusedWheelKey}" />
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding DressRows}" Background="{StaticResource Brush.GridLine}"
                                      IsEnabled="{Binding CanEdit}" ItemTemplate="{StaticResource ParameterCellTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Grid.Row="3" Text="{loc:Loc Wheel_DressDefaultsNote}" Style="{StaticResource Text.Label}"
                                   TextWrapping="Wrap" Margin="14,10" />
                    </Grid>

                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Wheel_HistoryHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Wheel_HistoryEmpty}" Margin="20" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WheelHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WheelHistory}" Margin="14,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Body}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding DiameterText}" Style="{StaticResource Text.DataRow}"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}"
                                                       Foreground="{StaticResource Brush.TextSecondary}">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SourceText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DetailText}" FontSize="{StaticResource Size.Caption}"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       Visibility="{Binding DetailText, Converter={StaticResource TextToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
