<UserControl x:Class="RollGrinder.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="{loc:Loc Monitor_Header}" FontSize="20" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Main_ConnectionLabel}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionText}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Monitor_ChannelStateLabel}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelStateText}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Monitor_ProgramLabel}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProgramNameText}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Monitor_MeasuredDiameterLabel}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MeasuredDiameterText}" Margin="0,0,0,6" FontFamily="Consolas" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Monitor_SnapshotAgeLabel}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SnapshotAgeText}" Margin="0,0,0,6" FontFamily="Consolas" />
            </Grid>

            <TextBlock Text="{loc:Loc Monitor_AxesHeader}" FontSize="16" Margin="0,16,0,8" />
            <DataGrid ItemsSource="{Binding Axes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MinHeight="160">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Monitor_AxisNameColumn}" Binding="{Binding Name}" Width="70" />
                    <DataGridTextColumn Header="{loc:Loc Monitor_AxisRoleColumn}" Binding="{Binding Role}" Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Monitor_AxisPositionColumn}" Binding="{Binding PositionText}" Width="110" />
                    <DataGridTextColumn Header="{loc:Loc Monitor_AxisSpeedColumn}" Binding="{Binding SpeedText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Monitor_TrendHeader}" FontSize="16" Margin="0,0,0,8" />
            <plot:WpfPlot x:Name="TrendPlot" />
        </DockPanel>
    </Grid>
</UserControl>
