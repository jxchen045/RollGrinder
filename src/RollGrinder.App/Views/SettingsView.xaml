<UserControl x:Class="RollGrinder.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls">
    <Grid>
        <Grid.Resources>
            <!-- 换砂轮向导：开着时盖住本页根部内容，导航槽这时显示"返回 设置"。 -->
            <Style x:Key="WheelChangePanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_WheelChange">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 砂轮页（修改稿 5.7）：开着时盖住本页根部内容，导航槽显示"返回 设置"。 -->
            <Style x:Key="WheelPanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_Wheel">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 每一步只露出这一步要填的东西：多摆几个空格子只会让人填错 -->
            <Style x:Key="WheelChangeEnterNewWheel" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WheelChangeStage}" Value="EnterNewWheel">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WheelChangeTrial" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WheelChangeStage}" Value="TrialGrind">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WheelChangeVerify" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WheelChangeStage}" Value="Verify">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 标定值：参数格由 MachineCalibration.Schema 生成 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Settings_CalibrationHeader}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{loc:Loc Settings_ReadOnlyHint}" Style="{StaticResource Text.Label}"
                                   Foreground="{StaticResource Brush.WarningFill}"
                                   Visibility="{Binding CanEdit, Converter={StaticResource InverseBool}}" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}"
                        BorderThickness="0,1,0,0" Padding="14">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Settings_WheelWear}" Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WheelWearText}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StatusResourceKey, Converter={StaticResource LocalizeConverter}}"
                                   FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                    </DockPanel>
                </Border>

                <!-- 按部件分组（修改稿 5③）：砂轮、金刚笔与修整、测头、基准盘、对刀、验收公差。 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CalibrationGroups}" IsEnabled="{Binding CanEdit}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" Margin="14,8,0,4" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Background="{StaticResource Brush.GridLine}"
                                                  ItemTemplate="{StaticResource ParameterCellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 改动记录：换砂轮是要追溯的事 -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <TextBlock Text="{loc:Loc Settings_AuditHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <TextBlock Text="{loc:Loc Settings_AuditEmpty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="20" FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Audit.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Audit}" Margin="14,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Label}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="15" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!--
            换砂轮向导：改手动对刀 → 手动对刀试磨 → 按实测反推砂轮直径 → 改回原来的对刀方式。
            机床上的活由人做，这一页只记数、切对刀方式、算修正值。
        -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource WheelChangePanel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="56">
                    <TextBlock Text="{loc:Loc WheelChange_Header}" Style="{StaticResource Text.CardTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="20,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc WheelChange_Next}" Command="{Binding WheelChangeNextCommand}"
                                Style="{StaticResource PrimaryButton}" Height="48" Padding="28,0" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc WheelChange_Skip}" Command="{Binding SkipWheelCorrectionCommand}"
                                Style="{StaticResource SecondaryButton}" Height="48" Padding="20,0" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc WheelChange_Cancel}" Command="{Binding CancelWheelChangeCommand}"
                                Style="{StaticResource SecondaryButton}" Height="48" Padding="20,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" Margin="20,0,0,0"
                                   Foreground="{StaticResource Brush.WarningFill}" />
                    </StackPanel>
                </Border>

                <!-- 每一步配一张图，标出这一步要量、要填的是哪个尺寸（修改稿 5②）。 -->
                <ctl:WheelDiagram DockPanel.Dock="Right" Width="420" Height="260" Margin="0,20,24,0" VerticalAlignment="Top"
                                  Mode="{Binding WizardDiagramMode}" HighlightKey="{Binding WizardHighlightKey}" />

                <StackPanel Margin="24,20">
                    <TextBlock Text="{Binding WheelChangeHint}" Style="{StaticResource Text.Body}"
                               FontSize="19" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <StackPanel Style="{StaticResource WheelChangeEnterNewWheel}">
                        <TextBlock Text="{loc:Loc Parameter_newWheelDiameterMm}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding NewWheelDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="220" HorizontalAlignment="Left"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource WheelChangeTrial}">
                        <TextBlock Text="{loc:Loc WheelChange_ExpectedDiameter}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TrialExpectedDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="220" HorizontalAlignment="Left"
                                 Margin="0,6,0,16" />
                        <TextBlock Text="{loc:Loc WheelChange_MeasuredDiameter}" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TrialMeasuredDiameterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="220" HorizontalAlignment="Left"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource WheelChangeVerify}">
                        <TextBlock Text="{Binding WheelChangeResultText}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="20" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock Text="{loc:Loc WheelChange_VerifyNote}" Style="{StaticResource Text.Label}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 砂轮：砂轮数据（简图）、修整参数（金刚笔简图）、修整与更换记录。参数格和标定值是同一批，按"保存"一起存。 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource WheelPanel}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}" Padding="14,10"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding WheelHelpText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,1,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Wheel_DataHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc Settings_WheelWear}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding WheelWearText}" FontFamily="{StaticResource Font.Mono}" FontSize="18"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="{loc:Loc Wheel_MaxSurfaceSpeed}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding MaxSurfaceSpeedText}" FontFamily="{StaticResource Font.Mono}" FontSize="18"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <ctl:WheelDiagram DockPanel.Dock="Top" Mode="Wheel" Height="220" Margin="10"
                                          HighlightKey="{Binding FocusedWheelKey}" />
                        <ItemsControl ItemsSource="{Binding WheelRows}" Background="{StaticResource Brush.GridLine}"
                                      IsEnabled="{Binding CanEdit}" ItemTemplate="{StaticResource ParameterCellTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="0,0,1,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Wheel_DressHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc Wheel_DressDefaultsNote}" Style="{StaticResource Text.Label}"
                                   TextWrapping="Wrap" Margin="14,10" />
                        <ctl:StepDiagram DockPanel.Dock="Top" StepTypeKey="WheelDress" Height="220" Margin="10"
                                         HighlightedParameterKey="{Binding FocusedWheelKey}" />
                        <ItemsControl ItemsSource="{Binding DressRows}" Background="{StaticResource Brush.GridLine}"
                                      IsEnabled="{Binding CanEdit}" ItemTemplate="{StaticResource ParameterCellTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Wheel_HistoryHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Wheel_HistoryEmpty}" Margin="20" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WheelHistory.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WheelHistory}" Margin="14,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <DockPanel>
                                                <TextBlock Text="{Binding KindText}" FontSize="16" FontWeight="Medium" />
                                                <TextBlock Text="{Binding DiameterText}" FontFamily="{StaticResource Font.Mono}" FontSize="15"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}"
                                                       Foreground="{StaticResource Brush.TextSecondary}">
                                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SourceText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DetailText}" FontSize="{StaticResource Size.Caption}"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       Visibility="{Binding DetailText, Converter={StaticResource TextToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
