<UserControl x:Class="RollGrinder.App.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        手动动作页（界面最终稿 5.4、5.5）。版式：上面是本页相关的位置（L1）和测量，下面是本页机构的状态格；
        动作只在右侧竖键上，一个动作一个键——卡片里不再放一批同样的按钮（双入口，C5）。
        测量对中换版：左边测点表 + 沿 Z 的直径小曲线，右边对中比对，两端之差 L1，并写出往哪边调。
    -->
    <Grid>
        <!-- 动作页 -->
        <Grid x:Name="ActionPage" Visibility="{Binding IsCentring, Converter={StaticResource InverseBoolVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{ctl:Px 480}" />
            </Grid.ColumnDefinitions>

            <!-- 上排三块：与自动页同一个控件（位置 · 主轴与进给 · 辅助功能）。 -->
            <views:MachineTopRow Grid.ColumnSpan="2" DataContext="{Binding StatusBand}" Margin="0,0,0,10" />

            <!-- 动作条件：这一页每个动作的联锁 ✓ / ✗ / —，灰键不再"不知道为什么"。动作本身只在右侧竖键上。 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedGroup.Title}" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{loc:Loc Manual_ConditionsHeader}" Style="{StaticResource Text.CardTitle}" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Conditions}" Margin="12,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CondRow" Padding="8,8" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ActionText}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}"
                                                       Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                            <TextBlock x:Name="CondText" Text="{Binding ConditionsText}" Style="{StaticResource Text.Label}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter TargetName="CondRow" Property="Background" Value="{StaticResource Brush.WarningRowFill}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Ready}" Value="False">
                                            <Setter TargetName="CondText" Property="Foreground" Value="{StaticResource Brush.Alarm}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_MeasureHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel Margin="16,8">
                        <TextBlock Text="{loc:Loc Manual_RollDiameter}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding MeasuredDiameterText}" Style="{StaticResource Text.Measurement}" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Live_ProbeA}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding ProbeAText}" Style="{StaticResource Text.DataRow}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Live_ProbeB}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding ProbeBText}" Style="{StaticResource Text.DataRow}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 测量对中 -->
        <Grid x:Name="CentringPage" Visibility="{Binding IsCentring, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{ctl:Px 640}" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <TextBlock Text="{loc:Loc Manual_PointsHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" Height="{ctl:Px 300}" Margin="8">
                        <plot:WpfPlot x:Name="PointsPlot" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,8">
                        <TextBlock Text="{loc:Loc Manual_JobIdLabel}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="False" Width="{ctl:Px 300}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Points}" Style="{StaticResource DataTable}" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Measurement_ColumnPosition}" Binding="{Binding BodyPositionText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Measurement_ColumnDiameter}" Binding="{Binding DiameterText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_CentringHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="16,10">
                        <TextBlock Text="{loc:Loc Centring_Difference}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding CentringDifferenceText}" Style="{StaticResource Text.Measurement}" />
                        <TextBlock Text="{Binding AlignmentHintText}" Style="{StaticResource Text.Body}" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.CurrentStep}"
                                   Visibility="{Binding HasAlignmentProblem, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{loc:Loc Manual_CentringRule}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Centring}" Style="{StaticResource DataTable}" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Centring_Quantity}" Binding="{Binding QuantityText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Manual_HeadSide}" Binding="{Binding HeadText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Manual_TailSide}" Binding="{Binding TailText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Centring_Difference}" Binding="{Binding DifferenceText}" Width="*">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataTableCell}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutOfTolerance}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.CurrentStep}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
