<UserControl x:Class="RollGrinder.App.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_AxisHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding AxisValues}" Background="{StaticResource Brush.GridLine}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ParameterCell}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="14" />
                                        <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Font.Mono}" FontSize="26" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_SpindleHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding SpindleValues}" Background="{StaticResource Brush.GridLine}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ParameterCell}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="14" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.DataRow}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_MeasureHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>

                    <Grid DockPanel.Dock="Top" Background="{StaticResource Brush.GridLine}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ParameterCell}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Live_ProbeA}" Style="{StaticResource Text.Label}" FontSize="14" />
                                <TextBlock Text="{Binding ProbeAText}" FontFamily="{StaticResource Font.Mono}" FontSize="26" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ParameterCell}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Live_ProbeB}" Style="{StaticResource Text.Label}" FontSize="14" />
                                <TextBlock Text="{Binding ProbeBText}" FontFamily="{StaticResource Font.Mono}" FontSize="26" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ParameterCell}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Manual_RollDiameter}" Style="{StaticResource Text.Label}" FontSize="14" />
                                <TextBlock Text="{Binding MeasuredDiameterText}" FontFamily="{StaticResource Font.Mono}" FontSize="26"
                                           Foreground="{StaticResource Brush.Accent}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ParameterCell}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Manual_MountingDeviation}" Style="{StaticResource Text.Label}" FontSize="14" />
                                <TextBlock Text="{Binding MountingDeviationText}" FontFamily="{StaticResource Font.Mono}" FontSize="26"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 对中：两端各记一组，比的是两端之差 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,12,14,0">
                        <Button Content="{loc:Loc Centring_CaptureHead}" Command="{Binding CaptureHeadCommand}"
                                Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Centring_CaptureTail}" Command="{Binding CaptureTailCommand}"
                                Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Centring_ClearButton}" Command="{Binding ClearCentringCommand}"
                                Style="{StaticResource SecondaryButton}" Height="42" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,12,14,0">
                        <Button Content="{loc:Loc Measurement_CaptureButton}" Command="{Binding CapturePointCommand}"
                                Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Measurement_ClearButton}" Command="{Binding ClearPointsCommand}"
                                Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Measurement_SaveButton}" Command="{Binding SaveMeasurementCommand}"
                                Style="{StaticResource SecondaryButton}" Height="42" Margin="0,0,8,0" />
                        <TextBox Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Width="150" Height="42" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding AlignmentHintText}" FontSize="16" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.CurrentStep}"
                                       Visibility="{Binding HasAlignmentProblem, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Label}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding Centring}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" Margin="14,12,14,0" FontSize="16" MinHeight="90"
                              Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Divider}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Centring_Quantity}" Binding="{Binding QuantityText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Manual_HeadSide}" Binding="{Binding HeadText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Manual_TailSide}" Binding="{Binding TailText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Centring_Difference}" Binding="{Binding DifferenceText}" Width="*">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <!-- 超差的那一行标出来：一眼看到该调哪一项 -->
                                            <DataTrigger Binding="{Binding IsOutOfTolerance}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.WarningFill}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1">
            <!-- 动作发出去的回执：停几秒自己消失，不占报警条 -->
            <Border Background="{StaticResource Brush.NormalFill}"
                    BorderBrush="{StaticResource Brush.Normal}"
                    BorderThickness="0,0,0,2"
                    Height="40"
                    Padding="14,0"
                    Margin="0,0,0,12"
                    Visibility="{Binding LastActionText, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="{Binding LastActionText}"
                           Style="{StaticResource Text.Body}"
                           VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_MeasuringArmHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding MeasuringArmActions}" Margin="12"
                                  ItemTemplate="{StaticResource MachineActionTemplate}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_TailstockHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding TailstockActions}" Margin="12"
                                  ItemTemplate="{StaticResource MachineActionTemplate}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Manual_OtherHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding OtherActions}" Margin="12"
                                  ItemTemplate="{StaticResource MachineActionTemplate}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
