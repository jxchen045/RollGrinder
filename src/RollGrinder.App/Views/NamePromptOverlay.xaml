<UserControl x:Class="RollGrinder.App.Views.NamePromptOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
    <!-- 起名字的框：盖在整页之上。DataContext 是 NamePromptViewModel。
         回车 = 确定，Esc = 取消（Esc 由外壳转给页面）——纯按键也能走完。
         名字被库里另一条占了才出现"覆盖"。 -->
    <Grid Background="#B3101418">
        <Border Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Accent}"
                BorderThickness="3"
                Width="640"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="28,24">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="26"
                           Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc NamePrompt_Label}" Style="{StaticResource Text.Label}" Margin="0,18,0,6" />
                <TextBox x:Name="NameBox"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="50" FontSize="20" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding ErrorText}" FontSize="17" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource Brush.CurrentStep}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="{loc:Loc NamePrompt_Confirm}" Command="{Binding ConfirmCommand}"
                            Style="{StaticResource DialogPrimaryButton}" />
                    <Button Content="{loc:Loc NamePrompt_Overwrite}" Command="{Binding OverwriteCommand}"
                            Style="{StaticResource DialogDangerButton}"
                            Visibility="{Binding CanOverwrite, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{loc:Loc NamePrompt_Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource DialogButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
