<UserControl x:Class="RollGrinder.App.Views.AutoGrindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:vm="clr-namespace:RollGrinder.App.ViewModels"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel>
        <!-- 上排三块（界面修订稿 v3 1.1）：位置 · 主轴与进给 · 辅助功能；与 JOG 页同一个控件。 -->
        <views:MachineTopRow x:Name="StatusBand" DockPanel.Dock="Top" DataContext="{Binding StatusBand}" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{ctl:Px 330}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{ctl:Px 372}" />
            </Grid.ColumnDefinitions>

            <!-- 左：工序序列 + 本支辊进度 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Auto_SequenceHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Auto_ProgressHeader}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                            <Border Height="14" Background="#DFE3E9">
                                <Rectangle Fill="{StaticResource Brush.Accent}" HorizontalAlignment="Left"
                                           Width="{Binding ProgressFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=302}" />
                            </Border>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding RemainingTimeText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                           Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                           Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 十几道工序放不下：能滑，看哪一道就把哪一道滚进视野（见代码后台）。 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="SequenceList" ItemsSource="{Binding Sequence}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 点一下：参数区改看这一道。正在看的那一道左边描一道竖条。 -->
                                    <Border Height="46" Margin="0,0,0,4" Padding="12,0" BorderBrush="{StaticResource Brush.Accent}"
                                            Background="{Binding State, Converter={StaticResource StepStateToBackground}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                        <Setter Property="BorderThickness" Value="6,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.FocusStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Border.InputBindings>
                                        <DockPanel>
                                            <TextBlock Text="{Binding OrderText}" Width="26"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                            <TextBlock Text="{Binding PassText}" DockPanel.Dock="Right"
                                                       FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                            <TextBlock Text="{Binding DisplayName}" FontSize="19" VerticalAlignment="Center"
                                                       Margin="12,0,0,0"
                                                       Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 中：曲线 + 工艺参数 -->
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{ctl:Px 286}" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <DockPanel>
                                <!-- 看哪条曲线由竖键 1–5 选（最终稿 D3），标题写当前这条。 -->
                                <TextBlock Text="{Binding CurveTitle}" Style="{StaticResource Text.CardTitle}" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ToleranceText}" FontSize="{StaticResource Size.Label}" Margin="0,0,20,0" />
                                    <TextBlock Text="{Binding RmsText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Label}" FontWeight="Bold" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <plot:WpfPlot x:Name="CurvePlot"
                                          Visibility="{Binding CurveHasData, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CurveEmptyText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurveHasData}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <!--
                    参数矩阵：行 = 参数，列 = 工序，一屏看完整支程序。
                    列头与每一格的底色跟着机床走——红色是正在跑的那一道，黄色是下一道，
                    用的是与左侧工序序列同一套 StepRowState 与同一套配色。
                -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 看一道：标题是那一道（底色与左边工序序列同一套）；看总表：原来的标题与说明。 -->
                                <Border Padding="10,2" VerticalAlignment="Center"
                                        Background="{Binding FocusedStep.State, Converter={StaticResource StepStateToBackground}}"
                                        Visibility="{Binding IsMatrixOverview, Converter={StaticResource InverseBoolVisibility}}">
                                    <TextBlock Text="{Binding FocusTitle}" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold"
                                               Foreground="{Binding FocusedStep.State, Converter={StaticResource StepStateToForeground}}" />
                                </Border>
                                <TextBlock Text="{loc:Loc Auto_MatrixHeader}" Style="{StaticResource Text.CardTitle}"
                                           Visibility="{Binding IsMatrixOverview, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{loc:Loc Auto_MatrixHint}" Style="{StaticResource Text.Label}"
                                           Margin="12,0,0,0" Foreground="{StaticResource Brush.TextMuted}"
                                           Visibility="{Binding IsMatrixOverview, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding MatrixMessage}" FontSize="{StaticResource Size.Caption}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.WarningFill}"
                                           Visibility="{Binding MatrixMessage, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!--
                            改参数不是实时通道：新值写进那一道工序的 R 参数，NC 在下一道次读取。
                            改过还没下发的格子标红，与 RGI 的做法一致；竖键 7 / 8 换成"放弃改动 / 下发改动"（最终稿 5.2）。
                        -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}"
                                BorderThickness="0,1,0,0" Padding="14,10"
                                Visibility="{Binding HasPendingEdits, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock Text="{loc:Loc Auto_MatrixPendingHint}" Style="{StaticResource Text.Label}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- 空状态与表格包在一起占满剩余空间：直接放在 DockPanel 里，空状态文字会被停靠到最左边。 -->
                        <Grid>
                        <TextBlock Text="{loc:Loc Auto_MatrixEmpty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource Size.Body}"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding HasMatrix, Converter={StaticResource InverseBoolVisibility}}" />

                        <!--
                            看一道（默认）：那一道的全部参数排成三列，一个不落、不用横着滚；改得动的就地改，改过标红，
                            与总表是同一批格子。底部一行写下一道是什么。
                        -->
                        <DockPanel>
                            <DockPanel.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                    <Binding Path="HasMatrix" />
                                    <Binding Path="IsMatrixOverview" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </DockPanel.Visibility>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding NextStepText}" Style="{StaticResource Text.Label}" Margin="14,6"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Auto_FocusNoParameters}" Style="{StaticResource Text.Label}" Margin="14,10">
                                <TextBlock.Visibility>
                                    <Binding Path="FocusCells.Count" Converter="{StaticResource EqualsToVisibility}" ConverterParameter="0" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding FocusCells}" Background="{StaticResource Brush.GridLine}" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="FocusCell" Background="{StaticResource Brush.Surface}" Margin="0,0,1,1" Padding="12,6">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Label}">
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                        <Run Text="{Binding UnitText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Cell.Text}" FontFamily="{StaticResource Font.Mono}"
                                                                   FontSize="{StaticResource Size.DataRow}" Margin="0,2,0,0"
                                                                   Visibility="{Binding Cell.CanEdit, Converter={StaticResource InverseBoolVisibility}}" />
                                                        <TextBox Text="{Binding Cell.Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 ctl:TouchInput.TapToEdit="True" ctl:TouchInput.Caption="{Binding Label}"
                                                                 Height="40" Margin="0,2,0,0"
                                                                 Visibility="{Binding Cell.CanEdit, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource ValueTextBox}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Cell.IsModified}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Brush.PendingValue}" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Cell.State}" Value="Done">
                                                    <Setter TargetName="FocusCell" Property="TextElement.Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- 看总表（横键"参数总表"）：行 = 参数，列 = 工序。 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                    <Binding Path="HasMatrix" />
                                    <Binding Path="IsMatrixOverview" />
                                </MultiBinding>
                            </ScrollViewer.Visibility>
                            <StackPanel Background="{StaticResource Brush.GridLine}">

                                <!-- 列头：工序名 -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{ctl:Px 190}" Height="52" Background="{StaticResource Brush.HeaderFill}"
                                            BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1"
                                            Padding="10,0">
                                        <TextBlock Text="{loc:Loc Auto_MatrixParameterColumn}"
                                                   Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding MatrixColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{ctl:Px 116}" Height="52" Padding="8,0"
                                                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1"
                                                        Background="{Binding State, Converter={StaticResource StepStateToBackground}}">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding OrderText}" FontSize="{StaticResource Size.Caption}"
                                                                   FontFamily="{StaticResource Font.Mono}"
                                                                   Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="{StaticResource Size.Caption}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 数据行：一个参数横着看过去 -->
                                <ItemsControl ItemsSource="{Binding MatrixRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="{ctl:Px 190}" Height="48" Padding="10,0"
                                                        Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1">
                                                    <DockPanel VerticalAlignment="Center">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UnitText}"
                                                                   Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
                                                        <TextBlock Text="{Binding Label}" FontSize="{StaticResource Size.Caption}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{ctl:Px 116}" Height="48"
                                                                    BorderBrush="{StaticResource Brush.Divider}"
                                                                    BorderThickness="0,0,1,1"
                                                                    Background="{Binding State, Converter={StaticResource StepStateToBackground}}">
                                                                <Grid>
                                                                    <!-- 改不动的格子：只读文本 -->
                                                                    <TextBlock Text="{Binding Text}" Margin="8,0"
                                                                               FontFamily="{StaticResource Font.Mono}"
                                                                               FontSize="{StaticResource Size.DataRow}" VerticalAlignment="Center"
                                                                               HorizontalAlignment="Right"
                                                                               Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}"
                                                                               Visibility="{Binding CanEdit, Converter={StaticResource InverseBoolVisibility}}" />

                                                                    <!-- 改得动的格子：就地编辑，改过标红 -->
                                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                             ctl:TouchInput.TapToEdit="True"
                                                                             ctl:TouchInput.Caption="{Binding ParameterKey}"
                                                                             FontFamily="{StaticResource Font.Mono}"
                                                                             FontSize="{StaticResource Size.DataRow}" BorderThickness="0"
                                                                             Background="Transparent" Padding="8,0"
                                                                             VerticalContentAlignment="Center"
                                                                             HorizontalContentAlignment="Right"
                                                                             Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBox.Style>
                                                                            <Style TargetType="TextBox">
                                                                                <Setter Property="Foreground"
                                                                                        Value="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{StaticResource Brush.PendingValue}" />
                                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBox.Style>
                                                                    </TextBox>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右：实测直径 + 实时数据 + 补偿状态 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Auto_MeasuredDiameterHeader}" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding MeasuredDiameterText}" Style="{StaticResource Text.Measurement}" />
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Auto_TargetLabel}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding TargetDiameterText}" FontSize="16" Margin="6,0,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{loc:Loc Auto_RemainingStockLabel}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding RemainingStockText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                           Margin="6,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Auto_LiveDataHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>

                        <!-- 实时数据与补偿状态一起滚：小屏（紧凑档位）上放不下时能滑，不被裁掉。 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LiveValues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DataRowBorder}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.RowAlternate}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding ValueText}" Style="{StaticResource Text.DataRow}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Label}" FontSize="17"
                                                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Bottom" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Auto_CompensationHeader}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,10" />
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding FeedForwardText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{loc:Loc Auto_FeedForward}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding StrokeVersionText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{loc:Loc Auto_StrokeCompensation}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding RealtimeOffsetText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource Brush.CurrentStep}" />
                                            <TextBlock Text="{loc:Loc Auto_RealtimeCompensation}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- 程序段（界面修订稿 v3：取代"状态总览"，机构灯已在上排）：NC 当前段 / 下一段、作业、工序与道次。 -->
            <Border x:Name="StatusOverviewPanel" Grid.ColumnSpan="3" Style="{StaticResource Card}"
                    Visibility="{Binding IsStatusOverviewOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <TextBlock Text="{loc:Loc SubView_ProgramBlock}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding BlockRows}" Margin="16,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel Margin="16,4">
                            <TextBlock Text="{loc:Loc Block_Current}" Style="{StaticResource Text.Label}" />
                            <Border Background="{StaticResource Brush.SelectionFill}" Padding="12,8" Margin="0,4,0,12">
                                <TextBlock Text="{Binding CurrentBlockText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Parameter}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{loc:Loc Block_Next}" Style="{StaticResource Text.Label}" />
                            <Border BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="1" Padding="12,8" Margin="0,4,0,0">
                                <TextBlock Text="{Binding NextBlockText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Body}"
                                           Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 结果横幅（界面修订稿 v3 U7）：磨完 ✓ 合格 / ✗ 不合格 + 判定依据；竖键 磨削记录 · 返磨… · 打印… · 下一支辊 ▸。 -->
            <Border x:Name="FinishPanel" Grid.ColumnSpan="3" Style="{StaticResource Card}"
                    Visibility="{Binding IsFinishOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Border x:Name="FinishHeader" DockPanel.Dock="Top" Padding="20,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.StepIdle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FinishPassedTrue}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Normal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FinishPassedFalse}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.Alarm}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="FinishTitleText" Text="{Binding FinishTitle}" FontSize="{StaticResource Size.Secondary}" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FinishPassedTrue}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FinishPassedFalse}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <DataGrid ItemsSource="{Binding FinishRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="16"
                              Style="{StaticResource DataTable}" HeadersVisibility="Column" VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Finish_ColItem}" Binding="{Binding ItemText}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Loc Finish_ColMeasured}" Binding="{Binding MeasuredText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Finish_ColAllowed}" Binding="{Binding AllowedText}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Finish_ColResult}" Binding="{Binding ResultText}" Width="0.6*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <!-- 补偿子视图（最终稿 5.3）：盖住本页根部内容，竖键 8"« 返回"。 -->
            <Border x:Name="CompensationPanel" Grid.ColumnSpan="3" Background="{StaticResource Brush.Background}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_Compensation">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{ctl:Px 400}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{ctl:Px 420}" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：NC 补偿状态 + 上位机补偿设定（制造商可改） -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Text="{loc:Loc Auto_CompensationHeader}" Style="{StaticResource Text.CardTitle}" />
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <StackPanel Margin="16,12">
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding FeedForwardText}" FontFamily="{StaticResource Font.Mono}" FontSize="16" HorizontalAlignment="Right" />
                                        <TextBlock Text="{loc:Loc Auto_FeedForward}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding StrokeVersionText}" FontFamily="{StaticResource Font.Mono}" FontSize="16" HorizontalAlignment="Right" />
                                        <TextBlock Text="{loc:Loc Auto_StrokeCompensation}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,18">
                                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding RealtimeOffsetText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource Brush.CurrentStep}" />
                                        <TextBlock Text="{loc:Loc Auto_RealtimeCompensation}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                    </DockPanel>

                                    <TextBlock Text="{loc:Loc Comp_TuningHeader}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TuningSourceText}" Style="{StaticResource Text.Label}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <StackPanel IsEnabled="{Binding CanEditCompensation}">
                                        <TextBlock Text="{loc:Loc Comp_Gain}" Style="{StaticResource Text.Label}" />
                                        <TextBox x:Name="TuningGainBox" Text="{Binding TuningGainText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ValueTextBox}" Margin="0,4,0,10" />
                                        <TextBlock Text="{loc:Loc Comp_SmoothingPoints}" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding TuningSmoothingText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ValueTextBox}" Margin="0,4,0,10" />
                                        <TextBlock Text="{loc:Loc Comp_MaxCorrection}" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding TuningMaxCorrectionText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ValueTextBox}" Margin="0,4,0,4" />
                                        <TextBlock Text="{Binding TuningLimitText}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc Comp_ManufacturerOnly}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding CanEditCompensation, Converter={StaticResource InverseBoolVisibility}}" />
                                    <TextBlock Text="{Binding TuningStatusText}" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Foreground="{StaticResource Brush.CurrentStep}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- 中：行程间补偿的收敛（NC 每修正一次记一行） -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Text="{loc:Loc Comp_StrokeHeader}" Style="{StaticResource Text.CardTitle}" />
                            </Border>
                            <DataGrid DockPanel.Dock="Bottom" Height="{ctl:Px 260}" ItemsSource="{Binding StrokeCorrections}" Style="{StaticResource DataTable}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnVersion}" Binding="{Binding VersionText}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnTime}" Binding="{Binding TimeText}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnOffset}" Binding="{Binding OffsetText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid>
                                <plot:WpfPlot x:Name="StrokePlot" />
                                <TextBlock Text="{loc:Loc Comp_NoStrokesYet}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextMuted}" FontSize="17"
                                           Visibility="{Binding HasStrokeCorrections, Converter={StaticResource InverseBoolVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- 右：这支辊的各次测量离目标多远 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                <TextBlock Text="{loc:Loc Comp_MeasurementHeader}" Style="{StaticResource Text.CardTitle}" />
                            </Border>
                            <DataGrid ItemsSource="{Binding MeasurementConvergence}" Style="{StaticResource DataTable}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnTime}" Binding="{Binding TimeText}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnStage}" Binding="{Binding StageText}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnRms}" Binding="{Binding RmsText}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc Comp_ColumnPv}" Binding="{Binding PeakToValleyText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
