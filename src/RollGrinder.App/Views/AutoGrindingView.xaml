<UserControl x:Class="RollGrinder.App.Views.AutoGrindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:vm="clr-namespace:RollGrinder.App.ViewModels"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="372" />
        </Grid.ColumnDefinitions>

        <!-- 左：工序序列 + 本支辊进度 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <TextBlock Text="{loc:Loc Auto_SequenceHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Auto_ProgressHeader}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                        <Border Height="14" Background="#DFE3E9">
                            <Rectangle Fill="{StaticResource Brush.Accent}" HorizontalAlignment="Left"
                                       Width="{Binding ProgressFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=302}" />
                        </Border>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding RemainingTimeText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                       Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Sequence}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="46" Margin="0,0,0,4" Padding="12,0"
                                    Background="{Binding State, Converter={StaticResource StepStateToBackground}}">
                                <DockPanel>
                                    <TextBlock Text="{Binding OrderText}" Width="26"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                    <TextBlock Text="{Binding PassText}" DockPanel.Dock="Right"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="19" VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 中：曲线 + 工艺参数 -->
        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="286" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="52">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Loc Curve_Error}" Command="{Binding SelectCurveCommand}" CommandParameter="{x:Static vm:CurveKind.Error}"
                                        Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                        Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=Error}" />
                                <Button Content="{loc:Loc Curve_Reference}" Command="{Binding SelectCurveCommand}" CommandParameter="{x:Static vm:CurveKind.Reference}"
                                        Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                        Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=Reference}" />
                                <Button Content="{loc:Loc Curve_Roundness}" Command="{Binding SelectCurveCommand}" CommandParameter="{x:Static vm:CurveKind.Roundness}"
                                        Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                        Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=Roundness}" />
                                <Button Content="{loc:Loc Curve_Eccentricity}" Command="{Binding SelectCurveCommand}" CommandParameter="{x:Static vm:CurveKind.Eccentricity}"
                                        Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                        Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=Eccentricity}" />
                                <Button Content="{loc:Loc Curve_GrindingCurrent}" Command="{Binding SelectCurveCommand}" CommandParameter="{x:Static vm:CurveKind.GrindingCurrent}"
                                        Style="{StaticResource SegmentButton}"
                                        Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=GrindingCurrent}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToleranceText}" Style="{StaticResource Text.Label}" Margin="0,0,20,0" />
                                <TextBlock Text="{Binding RmsText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <plot:WpfPlot x:Name="CurvePlot"
                                      Visibility="{Binding CurveHasData, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding CurveEmptyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurveHasData}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!--
                参数矩阵：行 = 参数，列 = 工序，一屏看完整支程序。
                列头与每一格的底色跟着机床走——红色是正在跑的那一道，黄色是下一道，
                用的是与左侧工序序列同一套 StepRowState 与同一套配色。
            -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Auto_MatrixHeader}" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{loc:Loc Auto_MatrixHint}" Style="{StaticResource Text.Label}"
                                       Margin="12,0,0,0" Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:Loc Auto_MatrixEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding HasMatrix, Converter={StaticResource InverseBoolVisibility}}" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasMatrix, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Background="{StaticResource Brush.GridLine}">

                            <!-- 列头：工序名 -->
                            <StackPanel Orientation="Horizontal">
                                <Border Width="190" Height="52" Background="{StaticResource Brush.HeaderFill}"
                                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1"
                                        Padding="10,0">
                                    <TextBlock Text="{loc:Loc Auto_MatrixParameterColumn}"
                                               Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding MatrixColumns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="116" Height="52" Padding="8,0"
                                                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1"
                                                    Background="{Binding State, Converter={StaticResource StepStateToBackground}}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OrderText}" FontSize="13"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 数据行：一个参数横着看过去 -->
                            <ItemsControl ItemsSource="{Binding MatrixRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="190" Height="40" Padding="10,0"
                                                    Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,1">
                                                <DockPanel VerticalAlignment="Center">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UnitText}"
                                                               Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
                                                    <TextBlock Text="{Binding Label}" FontSize="15"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="116" Height="40" Padding="8,0"
                                                                BorderBrush="{StaticResource Brush.Divider}"
                                                                BorderThickness="0,0,1,1"
                                                                Background="{Binding State, Converter={StaticResource StepStateToBackground}}">
                                                            <TextBlock Text="{Binding Text}"
                                                                       FontFamily="{StaticResource Font.Mono}"
                                                                       FontSize="16" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{Binding State, Converter={StaticResource StepStateToForeground}}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 右：实测直径 + 实时数据 + 补偿状态 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Auto_MeasuredDiameterHeader}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding MeasuredDiameterText}" Style="{StaticResource Text.Measurement}" />
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Auto_TargetLabel}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding TargetDiameterText}" FontSize="16" Margin="6,0,0,0"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{loc:Loc Auto_RemainingStockLabel}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Text="{Binding RemainingStockText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                       Margin="6,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Auto_LiveDataHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Auto_CompensationHeader}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,10" />
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock Text="{loc:Loc Auto_FeedForward}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding FeedForwardText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock Text="{loc:Loc Auto_StrokeCompensation}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding StrokeVersionText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="{loc:Loc Auto_RealtimeCompensation}" FontSize="16" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="{Binding RealtimeOffsetText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                           HorizontalAlignment="Right" Foreground="{StaticResource Brush.CurrentStep}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding LiveValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DataRowBorder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.RowAlternate}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="17"
                                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.DataRow}"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
