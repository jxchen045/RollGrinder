<UserControl x:Class="RollGrinder.App.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Records_Header}" FontSize="20" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Records_FromLabel}" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding FromDate}" Margin="8,0,16,0" />
            <TextBlock Text="{loc:Loc Records_ToLabel}" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding ToDate}" Margin="8,0,16,0" />
            <Button Content="{loc:Loc Records_QueryButton}" Command="{Binding QueryCommand}" Padding="16,6" />
            <Button x:Name="ExportButton" Content="{loc:Loc Records_ExportButton}" Click="OnExportClick" Margin="8,0,0,0" Padding="16,6" />
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{loc:Loc Records_NoteLabel}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8,0,0,0" />
            <Button Content="{loc:Loc Records_FinishButton}" Command="{Binding FinishSelectedCommand}" Margin="8,0,0,0" Padding="16,6" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Records_StartedColumn}" Binding="{Binding StartedText}" Width="160" />
                <DataGridTextColumn Header="{loc:Loc Records_RollColumn}" Binding="{Binding RollCode}" Width="140" />
                <DataGridTextColumn Header="{loc:Loc Records_ProfileColumn}" Binding="{Binding ProfileTypeText}" Width="140" />
                <DataGridTextColumn Header="{loc:Loc Records_StateColumn}" Binding="{Binding StateText}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc Records_DurationColumn}" Binding="{Binding DurationText}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc Records_DeviationColumn}" Binding="{Binding WorstDeviationText}" Width="140" />
                <DataGridTextColumn Header="{loc:Loc Records_RecordIdColumn}" Binding="{Binding RecordId}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
