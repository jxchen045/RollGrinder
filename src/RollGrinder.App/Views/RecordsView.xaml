<UserControl x:Class="RollGrinder.App.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        磨削记录（界面最终稿 5.11）：左是记录列表（合格绿、超差红），中是曲线（竖键 1–4 选），
        右是 12 项指标和备注。查询…、标记完成…、打印、导出 Excel 在竖键 5–8；磨前报表、日报、月报在横键。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{ctl:Px 400}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{ctl:ByLayout Standard=460, Compact=0}" />
        </Grid.ColumnDefinitions>
        <!-- 紧凑档（1366×768）三栏放不下：12 项指标挪到曲线下面（分辨率适配方案 3.5）。 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{ctl:ByLayout Standard=0, Compact=*}" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Card}" Margin="0,0,6,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Records_ListHeader}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SummaryLineText}" Style="{StaticResource Text.Body}"
                           Margin="12,8" TextWrapping="Wrap"
                           Visibility="{Binding SummaryLineText, Converter={StaticResource TextToVisibility}}" />
                <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" BorderThickness="0"
                         Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.PanningMode="VerticalOnly">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="56" Padding="12,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1">
                                <DockPanel VerticalAlignment="Center">
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StartedText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Label}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Size.Caption}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Brush.Normal}" />
                                    </StackPanel>
                                    <TextBlock x:Name="MarkCell" DockPanel.Dock="Right" Text="{Binding MarkText}" FontSize="{StaticResource Size.Caption}"
                                               VerticalAlignment="Center" Margin="8,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding RollCode}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProfileTypeText}" Style="{StaticResource Text.Label}" FontSize="{StaticResource Size.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="MarkCell" Property="Foreground" Value="{StaticResource Brush.Alarm}" />
                                    <Setter TargetName="MarkCell" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 中：曲线（竖键 1–4 选哪条），磨前 / 磨后叠在一起看这一趟磨掉了什么。 -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,6,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding CurveTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <Grid Margin="8">
                    <plot:WpfPlot x:Name="RecordPlot" Visibility="{Binding CurveHasData, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding CurveEmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="{ctl:Px 420}" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurveHasData}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右：12 项指标 + 备注 -->
        <Border Grid.Column="{ctl:ByLayout Standard=2, Compact=1}" Grid.Row="{ctl:ByLayout Standard=0, Compact=1}"
                Margin="{ctl:ByLayout Standard=0, Compact=0 6 6 0}" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedRecord.RollCode}" Style="{StaticResource Text.CardTitle}" FontWeight="Bold" />
                        <TextBlock Text="{loc:Loc Records_ResultHeader}" Style="{StaticResource Text.CardTitle}" Margin="10,0,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                    <TextBlock Text="{loc:Loc Records_NoteLabel}" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                             ctl:TouchInput.IsNumeric="False" Margin="0,4,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Metrics}" Background="{StaticResource Brush.GridLine}" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{x:Static ctl:LayoutProfile.MetricColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ParameterCell}" Padding="12,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="{StaticResource Size.Caption}" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.DataRow}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 查询…：起止日期（点日期弹月历）与三个快捷范围；竖键 7 / 8 = 取消 / 查询。 -->
        <Border x:Name="QueryPanel" Grid.ColumnSpan="3" Grid.RowSpan="2" Background="#B3101418"
                Visibility="{Binding IsQueryOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="{ctl:Px 720}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <TextBlock Text="{loc:Loc SubView_Query}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel Margin="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Records_FromLabel}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="56" Margin="10,0,20,0"
                                        FontSize="{StaticResource Size.Body}" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc Records_ToLabel}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="56" Margin="10,0,0,0"
                                        FontSize="{StaticResource Size.Body}" VerticalContentAlignment="Center" />
                        </Grid>
                        <UniformGrid Rows="1" Margin="0,16,0,0">
                            <Button Content="{loc:Loc Records_RangeToday}" Command="{Binding SetRangeCommand}" CommandParameter="1"
                                    Style="{StaticResource SegmentButton}" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Records_RangeWeek}" Command="{Binding SetRangeCommand}" CommandParameter="7"
                                    Style="{StaticResource SegmentButton}" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Records_RangeMonth}" Command="{Binding SetRangeCommand}" CommandParameter="30"
                                    Style="{StaticResource SegmentButton}" />
                        </UniformGrid>
                        <TextBlock Text="{loc:Loc Records_QueryHint}" Style="{StaticResource Text.Label}" Margin="0,14,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Border>

        <!--
            报表预览：纸上是什么样，这里就是什么样（同一份 FlowDocument），所以"预览没问题"就真的能打出来。
            竖键 1"打印"、8"« 返回"。
        -->
        <Border Grid.ColumnSpan="3">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_Report">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{loc:Loc Report_PreviewHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <FlowDocumentScrollViewer x:Name="ReportPreview" Margin="12" Background="{StaticResource Brush.Surface}"
                                          VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>

        <!-- 总览（界面修订稿 v3 6.8）：临近报废 · 今日计划变更 · 不合格待返磨，三块并排。 -->
        <Grid Grid.ColumnSpan="3" Background="{StaticResource Brush.Background}"
              Visibility="{Binding IsOverviewOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{Binding NearScrapTitle}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding NearScrapRows}" Margin="14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{Binding PlanChangeTitle}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding PlanChangeRows}" Margin="14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{Binding FailedTitle}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <!-- 待处理（设计稿 v4 5.8.1）：同一参数连续调了几次的，建议工艺员存为新方案。 -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="14,4,14,10">
                            <TextBlock Text="{Binding PendingTitle}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding PendingRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FailedRows}" Margin="14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
        </Grid>

        <!-- 统计（关系设计 M1、设计稿 v4 5.8）：查询日期范围内的例外与变更（按原因、按人）、本次调整按参数、每支辊去除量。 -->
        <Grid Grid.ColumnSpan="3" Background="{StaticResource Brush.Background}"
              Visibility="{Binding IsStatisticsOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource ActiveCardHeader}" Margin="0,0,6,6">
                <TextBlock Text="{Binding StatsTitle}" Style="{StaticResource Text.CardTitle}" />
            </Border>
            <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Stats_ByReason}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding StatsReasonRows}" Margin="14,8">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Stats_ByPerson}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding StatsPeopleRows}" Margin="14,8">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Stats_ByParameter}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding StatsParameterRows}" Margin="14,8">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,6,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Stats_Removal}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding StatsRemovalRows}" Margin="14,8">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 道次表（设计稿 v4 5.8.2）：存下来的逐道次、倍率摘要、事件、逐工序摘要（含有效值）。 -->
        <views:PassTableView Grid.ColumnSpan="3" DataContext="{Binding PassTable}"
                             Visibility="{Binding DataContext.IsPassTableOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

        <!-- 下发参数：这份作业下发时留的快照（辊形 / 程序版本、磨前直径、磨削量、工序、核对结论）。 -->
        <Grid Grid.ColumnSpan="3" Background="{StaticResource Brush.Background}"
              Visibility="{Binding IsSnapshotOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{Binding SnapshotTitle}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <!-- 本次调整（设计说明 5.4）：参数、方案值 → 本次值、谁、何时；核对时与运行中都列。 -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="14,4,14,10">
                            <TextBlock Text="{Binding SnapshotAdjustTitle}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding SnapshotAdjustments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SnapshotRows}" Margin="14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,6,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{loc:Loc Snapshot_Steps}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SnapshotSteps}" Margin="14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                            <TextBlock Text="{loc:Loc Snapshot_Checks}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding SnapshotChecks}" Margin="14,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
        </Grid>

        <!--
            存为新方案（设计稿 v4 5.8.4）：勾这一次的调整（核对时的默认勾，运行中的默认不勾），起名；
            作业所用方案已不是当前方案时橙色提示；名字重复时第 8 / 6 格灰。来源记为这一次作业。
        -->
        <Grid Grid.ColumnSpan="3" Background="{StaticResource Brush.Background}"
              Visibility="{Binding IsSaveAsPlanOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <TextBlock Text="{loc:Loc Records_SavePlanTitle}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Margin="14,10">
                        <TextBlock Text="{Binding SavePlanSource}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        <Border Background="{StaticResource Brush.WarningRowFill}" Padding="10,6" Margin="0,8,0,0"
                                Visibility="{Binding SavePlanWarning, Converter={StaticResource TextToVisibility}}">
                            <TextBlock Text="{Binding SavePlanWarning}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </Border>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{loc:Loc Records_SavePlanName}" Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                                       Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                            <TextBlock DockPanel.Dock="Right" Text="{loc:Loc PlanProblem_NameTaken}" Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Alarm}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding SavePlanNameTaken, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Text="{Binding SavePlanName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}" />
                        </DockPanel>
                        <TextBlock Text="{loc:Loc Records_SavePlanTick}" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SaveAdjustRows}" Margin="14,0,14,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsTicked}" IsEnabled="{Binding CanTick}" Margin="0,4" VerticalContentAlignment="Center">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Label}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
