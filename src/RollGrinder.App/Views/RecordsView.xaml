<UserControl x:Class="RollGrinder.App.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:rec="clr-namespace:RollGrinder.Services.Records;assembly=RollGrinder.Services"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <Grid.Resources>
            <!-- 报表预览子视图：开着时盖住本页根部内容，导航槽这时显示"返回 磨削记录"。 -->
            <!-- 轧辊台账子视图 -->
            <Style x:Key="LedgerPanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_RollLedger">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ReportPanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_Report">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <!-- 高度随内容：日期一行 + 查询按钮一行。写死高度会把两行裁成半截（曾把"查询"裁掉一半）。 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="Auto" Padding="14,10">
                    <!-- 日期一行、查询按钮一行：挤在一行时英文界面下按钮会被裁掉。 -->
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc Records_FromLabel}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="38" Margin="8,0" FontSize="15" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc Records_ToLabel}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="38" Margin="8,0,0,0" FontSize="15" />
                        <Button Grid.Row="1" Grid.ColumnSpan="4" Content="{loc:Loc Records_QueryButton}" Command="{Binding QueryCommand}"
                                Style="{StaticResource PrimaryButton}" Height="38" Margin="0,8,0,0" />
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Label}" FontSize="16" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Label}" FontSize="16"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <!-- 日报 / 月报那一行；没按过就不占地方 -->
                        <TextBlock Text="{Binding SummaryLineText}" Style="{StaticResource Text.Label}" FontSize="16"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Accent}"
                                   Visibility="{Binding SummaryLineText, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                         BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12" BorderBrush="{StaticResource Brush.PlotGridMinor}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StartedText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StateText}" FontSize="{StaticResource Size.Caption}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Brush.Normal}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RollCode}" FontFamily="{StaticResource Font.Mono}" FontSize="19" />
                                        <TextBlock Text="{Binding ProfileTypeText}" Style="{StaticResource Text.Label}" FontSize="{StaticResource Size.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRecord.RollCode}" Style="{StaticResource Text.CardTitle}"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="{loc:Loc Records_ResultHeader}" Style="{StaticResource Text.CardTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Metrics}" Background="{StaticResource Brush.GridLine}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ParameterCell}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="{StaticResource Size.Caption}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.DataRow}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- 四种曲线：磨前/磨后辊形、误差、圆度、补偿收敛过程 -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="52">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{loc:Loc Curve_BeforeAfter}" Command="{Binding SelectCurveCommand}"
                                    CommandParameter="{x:Static rec:RecordCurveKind.BeforeAfterProfile}"
                                    Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                    Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=BeforeAfterProfile}" />
                            <Button Content="{loc:Loc Curve_Error}" Command="{Binding SelectCurveCommand}"
                                    CommandParameter="{x:Static rec:RecordCurveKind.Deviation}"
                                    Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                    Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=Deviation}" />
                            <Button Content="{loc:Loc Curve_Roundness}" Command="{Binding SelectCurveCommand}"
                                    CommandParameter="{x:Static rec:RecordCurveKind.Roundness}"
                                    Style="{StaticResource SegmentButton}" Margin="0,0,10,0"
                                    Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=Roundness}" />
                            <Button Content="{loc:Loc Curve_Convergence}" Command="{Binding SelectCurveCommand}"
                                    CommandParameter="{x:Static rec:RecordCurveKind.CompensationConvergence}"
                                    Style="{StaticResource SegmentButton}"
                                    Tag="{Binding SelectedCurve, Converter={StaticResource EnumEquals}, ConverterParameter=CompensationConvergence}" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                            BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,10">
                        <!-- 备注写明是备注；"完成"按钮按文字自适应宽度，英文下不被截断。 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Records_NoteLabel}" Style="{StaticResource Text.Label}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ValueTextBox}" Width="320" />
                            <Button Content="{loc:Loc Records_FinishButton}" Command="{Binding FinishSelectedCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="46" MinWidth="160" Padding="20,0" Margin="10,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="8">
                        <plot:WpfPlot x:Name="RecordPlot"
                                      Visibility="{Binding CurveHasData, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding CurveEmptyText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurveHasData}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 轧辊台账：每支辊磨过几次、上次什么时候 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource LedgerPanel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="56">
                    <TextBlock Text="{loc:Loc Records_LedgerHeader}" Style="{StaticResource Text.CardTitle}"
                               VerticalAlignment="Center" />
                </Border>
                <DataGrid ItemsSource="{Binding Ledger}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" Margin="12" FontSize="16"
                          Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Divider}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Ledger_Code}" Binding="{Binding Code}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_Diameter}" Binding="{Binding DiameterText}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_BodyLength}" Binding="{Binding BodyLengthText}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_Material}" Binding="{Binding MaterialText}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_GrindCount}" Binding="{Binding GrindCountText}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_LastGround}" Binding="{Binding LastGroundText}" Width="1.6*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!--
            报表预览：纸上是什么样，这里就是什么样（同一份 FlowDocument），
            所以"预览没问题"就真的能打出来。
        -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ReportPanel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="56">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Report_PreviewHeader}" Style="{StaticResource Text.CardTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="{loc:Loc Report_PrintButton}" Click="OnPrintClick"
                                Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0"
                                HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
                <FlowDocumentScrollViewer x:Name="ReportPreview" Margin="12"
                                          Background="{StaticResource Brush.Surface}"
                                          VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
