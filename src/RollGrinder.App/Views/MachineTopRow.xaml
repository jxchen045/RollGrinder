<UserControl x:Class="RollGrinder.App.Views.MachineTopRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls">
    <!--
        自动页与 JOG 页共用的上排三块（界面修订稿 v3 1.1）：
        位置（X · X1 · Z · U，L1 大字 + 剩余行程）· 主轴与进给（转速、线速、进给、倍率）· 辅助功能（五组，每组一行，四态灯）。
        上面一行是方式、通道、程序。DataContext 是 StatusBandViewModel。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.25*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="12,6">
            <DockPanel>
                <!-- 一行：方式 · 通道 · 参考点 · 程序（只写值，值本身看得懂，紧凑档也排得下一行），右端是剩余行程那一列的列名。 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{loc:Loc Top_Remaining}" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="8,0,0,0" />
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <!-- 一行排不下（紧凑档位、英文）就折到第二行，不切掉后面的字段。 -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ValueText}" ToolTip="{Binding Label}" Margin="0,0,12,0"
                                           FontSize="{StaticResource Size.Caption}" FontWeight="SemiBold"
                                           Visibility="{Binding IsPrimary, Converter={StaticResource InverseBoolVisibility}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Axes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static ctl:LayoutProfile.AxisNameColumn}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource Size.Parameter}" FontWeight="Bold" VerticalAlignment="Center"
                                           ToolTip="{Binding RoleText}" />
                                <TextBlock Grid.Column="1" Text="{Binding PositionText}" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource Size.Secondary}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource Size.DataRow}" Foreground="{StaticResource Brush.TextSecondary}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Top_Drives}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static ctl:LayoutProfile.AxisNameColumn}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{x:Static ctl:LayoutProfile.OverrideColumn}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Symbol}" FontSize="{StaticResource Size.Body}" FontWeight="Bold" VerticalAlignment="Center"
                                           ToolTip="{Binding Label}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ValueText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SecondaryText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}"
                                               Foreground="{StaticResource Brush.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <!-- 倍率不是 100 %：琥珀底色提醒（红色只留给报警）。 -->
                                <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverrideOff}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.WarningRowFill}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.WarningFill}" />
                                                    <Setter Property="TextElement.FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding OverrideText}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Size.Caption}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Top_Aux}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                <!-- 组名一列按最长的那个定宽（各行共用），英文组名比中文长也不切字。 -->
                <ItemsControl ItemsSource="{Binding Groups}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{x:Static ctl:LayoutProfile.StatusGroupColumnWidth}" SharedSizeGroup="GroupLabel" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Margin="0,0,6,0"
                                           FontSize="{StaticResource Size.Caption}" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Lamps}" ItemTemplate="{StaticResource StatusLampCompactTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
