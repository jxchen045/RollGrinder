<UserControl x:Class="RollGrinder.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <TextBlock Text="{loc:Loc Profile_SegmentsHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0">
                    <TextBlock Text="{loc:Loc Profile_Name}" Style="{StaticResource Text.Label}"
                               VerticalAlignment="Center" Width="72" />
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                             Height="46" FontSize="17" VerticalContentAlignment="Center" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
                    <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedTypeForInsert}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                              Width="120" Height="46" FontSize="17" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Profile_Insert}" Command="{Binding InsertSegmentCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButton}" Height="46" Width="66" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Profile_Delete}" Command="{Binding RemoveSegmentCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButton}" Height="46" Width="66" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Profile_MoveUp}" Command="{Binding MoveSegmentUpCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButton}" Height="46" Width="66" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc Profile_SegmentFrom}" Style="{StaticResource Text.Label}"
                                       VerticalAlignment="Center" Width="72" />
                            <TextBox Text="{Binding SegmentFromMmText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                     Height="42" FontSize="16" FontFamily="{StaticResource Font.Mono}"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc Profile_SegmentTo}" Style="{StaticResource Text.Label}"
                                       VerticalAlignment="Center" Width="72" />
                            <TextBox Text="{Binding SegmentToMmText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                     Height="42" FontSize="16" FontFamily="{StaticResource Font.Mono}"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>
                        <CheckBox Content="{loc:Loc Profile_SegmentMirrored}" IsChecked="{Binding SegmentIsMirrored}"
                                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                  FontSize="16" Margin="0,0,0,12" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Profile_ValidationHeader}" Style="{StaticResource Text.Label}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="{loc:Loc Profile_MaxChordError}" FontSize="16" />
                            <TextBlock Text="{Binding MaxChordErrorText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Brush.Normal}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="{loc:Loc Profile_SegmentCount}" FontSize="16" />
                            <TextBlock Text="{Binding SegmentCountText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="{loc:Loc Profile_TaperAlignment}" FontSize="16" />
                            <TextBlock Text="{Binding TaperAlignmentText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Brush.Normal}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="{loc:Loc Profile_CompensationAxis}" FontSize="16" />
                            <TextBlock Text="{Binding CompensationAxisText}" FontFamily="{StaticResource Font.Mono}" FontSize="16"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}"
                         BorderThickness="0" Background="Transparent" Margin="8,0,8,8"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="54" Padding="12,0" Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.StepIdle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.SelectionFill}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                <Setter Property="BorderThickness" Value="5,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OrderText}" Width="22" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="15" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" />
                                        <TextBlock Text="{Binding PurposeText}" Style="{StaticResource Text.Label}" FontSize="14" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="52">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Profile_PreviewHeader}" Style="{StaticResource Text.CardTitle}" Margin="0,0,16,0" />
                            <Rectangle Width="22" Height="3" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Profile_LegendComposed}" FontSize="15" Margin="7,0,16,0" VerticalAlignment="Center" />
                            <Rectangle Width="22" Height="3" Fill="{StaticResource Brush.Reference}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Profile_LegendMain}" FontSize="15" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <plot:WpfPlot x:Name="PreviewPlot" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Profile_ParametersHeader}" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding SegmentParametersTitle}" Style="{StaticResource Text.CardTitle}"
                                       Margin="10,0,16,0" Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="{loc:Loc Profile_SchemaNote}" Style="{StaticResource Text.Label}"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding SegmentParameters}"
                                  Background="{StaticResource Brush.GridLine}"
                                  ItemTemplate="{StaticResource ParameterCellTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 辊形库：盖在整页之上，和区域菜单同一种做法——不另开窗口，触摸屏上好点。 -->
        <Border Grid.ColumnSpan="2" Background="#CC101418"
                Visibility="{Binding IsLibraryOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="720" Height="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Profile_Library}" Style="{StaticResource Text.CardTitle}" />
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="14">
                        <Button Content="{loc:Loc Profile_LibraryOpen}" Command="{Binding LoadFromLibraryCommand}"
                                Style="{StaticResource PrimaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Profile_LibraryDelete}" Command="{Binding DeleteFromLibraryCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Profile_LibraryClose}" Command="{Binding CloseLibraryCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" />
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Profile_LibraryEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LibraryEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid ItemsSource="{Binding LibraryEntries}" SelectedItem="{Binding SelectedLibraryEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Margin="14,8" FontSize="16" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnName}"
                                                Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnType}"
                                                Binding="{Binding ProfileTypeKey}" Width="140" />
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnSegments}"
                                                Binding="{Binding SegmentCount}" Width="80" />
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnModified}"
                                                Binding="{Binding ModifiedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
