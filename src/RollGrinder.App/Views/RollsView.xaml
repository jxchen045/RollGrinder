<UserControl x:Class="RollGrinder.App.Views.RollsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:views="clr-namespace:RollGrinder.App.Views">
    <!--
        轧辊区（界面修订稿 v3 6.4）。根画面：左边在用的辊（标记：中断 / 返磨 / 临报废 / 推断 / 作废），右边选中那支的卡片、寿命条与磨削履历。
        子视图：登记 / 编辑表、多选（行首出勾选框）、改计划（逐支核对）、导入预览；选辊形 / 选程序盖在上面（与作业共用）。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{ctl:Px 640}" />
        </Grid.ColumnDefinitions>

        <!-- 左：台账列表（根画面、多选） -->
        <Border Style="{StaticResource Card}" Margin="0,0,6,0"
                Visibility="{Binding IsLedger, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Ledger_Code}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc Ledger_Kind}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc Ledger_Purpose}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="3" Text="{loc:Loc Ledger_CurrentDiameter}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="{loc:Loc Rolls_ColRemaining}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{loc:Loc Rolls_ColMark}" Style="{StaticResource Text.Label}" Margin="16,0,0,0" />
                </Grid>
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0"
                         Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.PanningMode="VerticalOnly">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="52" Padding="12,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  IsEnabled="{Binding IsRetired, Converter={StaticResource InverseBool}}"
                                                  Visibility="{Binding DataContext.IsMulti, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock x:Name="IdText" Text="{Binding RollId}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PurposeText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding CurrentText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Body}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RemainingCell" Grid.Column="4" Text="{Binding RemainingText}" FontFamily="{StaticResource Font.Mono}"
                                               Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding MarkText}" Style="{StaticResource Text.Label}" Margin="16,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRetired}" Value="True">
                                    <Setter TargetName="IdText" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                                    <Setter TargetName="IdText" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLowLife}" Value="True">
                                    <Setter TargetName="RemainingCell" Property="Foreground" Value="{StaticResource Brush.Alarm}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 左：登记 / 编辑表 -->
        <Border Style="{StaticResource Card}" Margin="0,0,6,0"
                Visibility="{Binding IsForm, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <Grid Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{ctl:Px 200}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc Ledger_Code}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding FormRollId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 IsEnabled="{Binding IsNewRoll}" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc Ledger_Kind}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormKindText}" Style="{StaticResource Text.Body}" Margin="0,10" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc Ledger_BodyLength}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FormBodyLengthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="True" Margin="0,4" />
                        <TextBlock Grid.Row="3" Text="{loc:Loc Ledger_NominalDiameter}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FormNominalText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="True" Margin="0,4" />
                        <TextBlock Grid.Row="4" Text="{loc:Loc Ledger_CurrentDiameter}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FormCurrentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="True" Margin="0,4" />
                        <TextBlock Grid.Row="5" Text="{loc:Loc Ledger_ScrapDiameter}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FormScrapText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="True" Margin="0,4" />
                        <TextBlock Grid.Row="6" Text="{loc:Loc Ledger_Material}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FormMaterial, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}" Margin="0,4" />
                        <TextBlock Grid.Row="7" Text="{loc:Loc RollData_NetWeight}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding FormNetWeightText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="True" Margin="0,4" />
                        <TextBlock Grid.Row="8" Text="{loc:Loc Ledger_Purpose}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <Grid Grid.Row="8" Grid.Column="1">
                            <TextBlock Text="{Binding FormPurpose}" Style="{StaticResource Text.Body}" Margin="0,10"
                                       Visibility="{Binding FormPurposeEditable, Converter={StaticResource InverseBoolVisibility}}" />
                            <TextBox Text="{Binding FormPurpose, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}" Margin="0,4"
                                     Visibility="{Binding FormPurposeEditable, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Grid.Row="9" Text="{loc:Loc Rolls_PlanProfile}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding FormProfileText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,10" />
                        <TextBlock Grid.Row="10" Text="{loc:Loc Rolls_PlanProgram}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding FormProgramText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,10" />
                        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="{loc:Loc Rolls_FormHint}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 左：改计划逐支核对 -->
        <Border Style="{StaticResource Card}" Margin="0,0,6,0"
                Visibility="{Binding IsChangePlan, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                </Border>
                <DockPanel DockPanel.Dock="Bottom" Margin="14,8">
                    <TextBlock Text="{loc:Loc Rolls_Reason}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Text="{Binding PlanReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding PlanChecks}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource DataTable}" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Ledger_Code}" Binding="{Binding RollId}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_Purpose}" Binding="{Binding PurposeText}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Rolls_ColCheck}" Binding="{Binding ResultText}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 右：选中那支的卡片 + 履历（根画面、多选、改计划时） -->
        <Grid Grid.Column="1" Visibility="{Binding IsImport, Converter={StaticResource InverseBoolVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{Binding CardTitle}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <StackPanel Margin="14,8">
                        <ItemsControl ItemsSource="{Binding CardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Text.Label}" Margin="0,6,0,4" />
                        <ProgressBar Height="10" Minimum="0" Maximum="1" Value="{Binding RemainingFraction, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{Binding LowerTitle}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <Grid>
                        <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource DataTable}" HeadersVisibility="Column"
                                  Visibility="{Binding IsForm, Converter={StaticResource InverseBoolVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Rolls_ColDate}" Binding="{Binding DateText}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Rolls_PlanProfile}" Binding="{Binding ProfileText}" Width="1.4*" />
                                <DataGridTextColumn Header="{loc:Loc Rolls_ColRemoved}" Binding="{Binding RemovedText}" Width="0.8*" />
                                <DataGridTextColumn Header="{loc:Loc Rolls_ColResult}" Binding="{Binding ResultText}" Width="0.6*" />
                                <DataGridTextColumn Header="{loc:Loc Rolls_ColMark}" Binding="{Binding MarkText}" Width="1.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ItemsControl ItemsSource="{Binding FormProblems}" Margin="14,8"
                                      Visibility="{Binding IsForm, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Alarm}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 导入预览：整宽 -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Card}"
                Visibility="{Binding IsImport, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding ImportTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <DataGrid ItemsSource="{Binding ImportRows}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource DataTable}" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Rolls_ColLine}" Binding="{Binding LineNumber}" Width="0.4*" />
                        <DataGridTextColumn Header="{loc:Loc Rolls_ColImportKind}" Binding="{Binding KindText}" Width="0.6*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_Code}" Binding="{Binding RollId}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Ledger_BodyLength}" Binding="{Binding BodyText}" Width="0.7*" />
                        <DataGridTextColumn Header="{loc:Loc Rolls_PlanProfile}" Binding="{Binding ProfileText}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Rolls_ColProblem}" Binding="{Binding ProblemText}" Width="2.4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 选辊形 / 选程序（与作业共用），盖在上面 -->
        <views:PlanPickerView Grid.ColumnSpan="2" DataContext="{Binding Picker}"
                              Visibility="{Binding DataContext.IsPicking, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
