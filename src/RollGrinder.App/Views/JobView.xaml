<UserControl x:Class="RollGrinder.App.Views.JobView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        作业（界面修订稿 v3 6.3）。根画面：待磨清单（中断 / 返磨置顶），上面一格输入辊号或尾号。
        "下作业 ▸"进一页核对：左边核对清单（✕ 不通过排最前），右边计划与这一次、磨前直径与本次磨削量、"磨成什么样"、程序步骤。
        全部不拦时第 7 / 8 格是"✕ 返回清单 / ✓ 确认下发"。换辊形 / 换程序盖一层选择子视图（与轧辊区共用）。
    -->
    <Grid>
        <!-- 根画面：待磨清单 -->
        <Border Style="{StaticResource Card}" Visibility="{Binding IsQueue, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Right" Width="{ctl:Px 320}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ValueTextBox}" Height="38" IsReadOnly="False" ToolTip="{loc:Loc Job_SearchHint}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchEnterCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock DockPanel.Dock="Right" Text="{loc:Loc Job_SearchLabel}" Style="{StaticResource Text.CardTitle}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding QueueTitle}" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Ledger_Code}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc Ledger_Kind}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc Ledger_Purpose}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="3" Text="{loc:Loc Rolls_PlanProfile}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="4" Text="{loc:Loc Rolls_ColRemaining}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{loc:Loc Job_ColLastGround}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="{loc:Loc Rolls_ColMark}" Style="{StaticResource Text.Label}" Margin="16,0,0,0" />
                </Grid>
                <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueRow}" BorderThickness="0"
                         Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.PanningMode="VerticalOnly">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" Height="52" Padding="12,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1"
                                    Background="Transparent"
                                    ctl:TouchInput.LongPressCommand="{Binding DataContext.OpenReviewForSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RollId}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontFamily="{StaticResource Font.Mono}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PurposeText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding PlanText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding RemainingText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Body}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding LastText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Label}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MarkCell" Grid.Column="6" Text="{Binding MarkText}" Style="{StaticResource Text.Body}" Margin="16,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.WarningRowFill}" />
                                    <Setter TargetName="MarkCell" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 一页核对 -->
        <Grid Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CheckSummaryText}" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding ReviewTitle}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="12,8">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CheckRow" Padding="8,6" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding Glyph}" Width="28" FontWeight="Bold"
                                                   Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Normal}" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding ItemText}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}"
                                                   Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MessageText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNotice}" Value="True">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.WarningFill}" />
                                        <Setter TargetName="CheckRow" Property="Background" Value="{StaticResource Brush.WarningRowFill}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlock}" Value="True">
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Alarm}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="14,10">
                        <ItemsControl ItemsSource="{Binding PlanRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc Job_StartDiameter}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding StartDiameterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                     ctl:TouchInput.IsNumeric="True" Margin="0,2,16,2" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc Job_StockMm}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="3" Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                     ctl:TouchInput.IsNumeric="True" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding MaxStockText}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{loc:Loc Job_TargetDiameter}" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding TargetText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" />
                            </StackPanel>
                        </Grid>

                        <!--
                            磨削起点（机床 Z）：这次装夹辊身头架侧端面的位置，跟着装夹走，所以在作业里示教（原机"设置起点"）。
                            默认带上一次的值；NC 不要这个数（tagmap 没登记 job.grindStartZMm）时整行不显示。
                        -->
                        <DockPanel Margin="0,8,0,0" Visibility="{Binding UsesGrindStart, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Job_GrindStartZ}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Job_TeachGrindStart}" Command="{Binding TeachGrindStartCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="12,2,0,2" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GrindStartNote}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <TextBox Text="{Binding GrindStartZText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                     ctl:TouchInput.IsNumeric="True" Margin="0,2" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDurationText}" Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Text="{loc:Loc Job_ReviewCurveTitle}" Style="{StaticResource Text.CardTitle}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ProgramSteps}" Margin="12,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,16,2">
                                        <Run Text="{Binding OrderText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding DurationText, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <plot:WpfPlot x:Name="ReviewPlot" Margin="6" />
                    </DockPanel>
                </Border>

                <!-- 本次取舍：这一支辊开磨前走不走哪段 NC 子程序。只列用得上的（程序里有那道工序、机床有那个装置）。 -->
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Job_RunOptionsHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ProgramOptions}" Margin="8"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsOn}" Height="42" Margin="2" HorizontalContentAlignment="Left"
                                                  Style="{StaticResource ProgramOptionToggle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" Margin="10,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ButtonBorder}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Job_OptionChanged}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                                                       FontSize="{StaticResource Size.Label}" Foreground="{StaticResource Brush.PendingValue}"
                                                       Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!--
            本次调整（设计稿 v4 5.2.5）：左边能调的参数（工序、参数、设定值、本次值、允许、上次），不能调的 🔒 列在下面；
            右边是选中那一项的大 −/+ 与范围条。超范围的行标红，"✓ 用于本次"不收。竖键 1 载入上次、2 恢复这一项、6 全部恢复设定值…
        -->
        <Grid Background="{StaticResource Brush.Background}"
              Visibility="{Binding IsAdjusting, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{ctl:Px 420}" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                        <TextBlock Text="{Binding AdjustTitle}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Grid DockPanel.Dock="Top" Margin="12,6,12,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Adjust_ColStep}" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc Adjust_ColParameter}" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc Adjust_ColPlan}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{loc:Loc Adjust_ColJob}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{loc:Loc Adjust_ColAllowed}" Style="{StaticResource Text.Label}" Margin="16,0,0,0" />
                        <TextBlock Grid.Column="5" Text="{loc:Loc Adjust_ColLast}" Style="{StaticResource Text.Label}" />
                    </Grid>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding LockedRows}" Margin="12,6,12,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,18,2" Foreground="{StaticResource Brush.DisabledText}">
                                    <Run Text="&#x1F512;" />
                                    <Run Text="{Binding StepText, Mode=OneWay}" />
                                    <Run Text="{Binding ParameterText, Mode=OneWay}" />
                                    <Run Text="{Binding ValueText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc Adjust_LockedHeader}" Style="{StaticResource Text.Label}" Margin="12,6,12,0" />
                    <ListBox ItemsSource="{Binding AdjustRows}" SelectedItem="{Binding SelectedAdjustRow}" BorderThickness="0"
                             Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.PanningMode="VerticalOnly">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Height="52" Padding="12,0" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ParameterText, Mode=OneWay}" />
                                            <Run Text="{Binding UnitText, Mode=OneWay}" Foreground="{StaticResource Brush.DisabledText}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding PlanText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Body}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBox x:Name="ValueBox" Grid.Column="3" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                                 ctl:TouchInput.IsNumeric="True" HorizontalContentAlignment="Right" Margin="6,4,0,4" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Text.Label}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding AllowedText, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                            <Run Text="{Binding ModeText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="5" Text="{Binding LastText}" Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.PendingValue}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter TargetName="ValueBox" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="ValueBox" Property="Foreground" Value="{StaticResource Brush.PendingValue}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRefused}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.WarningRowFill}" />
                                        <Setter TargetName="ValueBox" Property="Foreground" Value="{StaticResource Brush.Alarm}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" DataContext="{Binding SelectedAdjustRow}">
                <StackPanel Margin="16,12">
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding ParameterText}" Style="{StaticResource Text.CardTitle}" Margin="0,2,0,10" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc Adjust_ColPlan}" Style="{StaticResource Text.Label}" Width="{ctl:Px 120}" />
                        <TextBlock Text="{Binding PlanText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Body}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="{loc:Loc Adjust_ColAllowed}" Style="{StaticResource Text.Label}" Width="{ctl:Px 120}" />
                        <TextBlock Text="{Binding AllowedText}" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Body}" />
                    </DockPanel>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{ctl:Px 96}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{ctl:Px 96}" />
                        </Grid.ColumnDefinitions>
                        <Button Content="&#x2212;" FontSize="36" Height="{ctl:Px 84}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DataContext.AdjustDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox Grid.Column="1" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValueTextBox}"
                                 ctl:TouchInput.IsNumeric="True" FontSize="32" HorizontalContentAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="2" Content="+" FontSize="36" Height="{ctl:Px 84}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DataContext.AdjustUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>
                    <Slider Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue}" Margin="0,4"
                            Visibility="{Binding HasSlider, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding DeltaText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.PendingValue}" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding RefusalText}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Alarm}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LastText}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <views:PlanPickerView DataContext="{Binding Picker}"
                              Visibility="{Binding DataContext.IsPicking, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
