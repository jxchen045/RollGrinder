<Window x:Class="RollGrinder.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RollGrinder.App.Localization"
        xmlns:views="clr-namespace:RollGrinder.App.Views"
        Title="{loc:Loc App_Title}"
        Height="900"
        Width="1440"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E2A36" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding MachineDisplayName}" Foreground="White" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GatewayName}" Foreground="#B0BEC5" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{loc:Loc Shell_Subtitle}" Foreground="#B0BEC5" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,8" Background="#ECEFF1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LatestAlarmText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#37474F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveAlarm}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Content="{loc:Loc Shell_ClearAlarmsButton}" Command="{Binding ClearAlarmsCommand}" Padding="12,4" />
            </Grid>
        </Border>

        <TabControl Padding="0">
            <TabItem Header="{loc:Loc Tab_Monitor}">
                <views:MonitorView DataContext="{Binding Monitor}" />
            </TabItem>
            <TabItem Header="{loc:Loc Tab_Job}">
                <views:JobEditorView DataContext="{Binding JobEditor}" />
            </TabItem>
            <TabItem Header="{loc:Loc Tab_Measurement}">
                <views:MeasurementView DataContext="{Binding Measurement}" />
            </TabItem>
            <TabItem Header="{loc:Loc Tab_Records}">
                <views:RecordsView DataContext="{Binding Records}" />
            </TabItem>
            <TabItem Header="{loc:Loc Tab_Alarms}">
                <DataGrid ItemsSource="{Binding AlarmRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Margin="16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Alarm_TimeColumn}" Binding="{Binding TimeText}" Width="180" />
                        <DataGridTextColumn Header="{loc:Loc Alarm_SeverityColumn}" Binding="{Binding SeverityText}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Alarm_MessageColumn}" Binding="{Binding Message}" Width="320" />
                        <DataGridTextColumn Header="{loc:Loc Alarm_DetailColumn}" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
