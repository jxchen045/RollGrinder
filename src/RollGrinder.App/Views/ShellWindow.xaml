<Window x:Class="RollGrinder.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RollGrinder.App.Localization"
        xmlns:vm="clr-namespace:RollGrinder.App.ViewModels"
        xmlns:views="clr-namespace:RollGrinder.App.Views"
        Title="{loc:Loc App_Title}"
        Width="1920"
        Height="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Sans}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AutoGrindingViewModel}">
            <views:AutoGrindingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StepsViewModel}">
            <views:StepsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordsViewModel}">
            <views:RecordsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManualViewModel}">
            <views:ManualView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- 顶栏 76：品牌 / 页面上下文 / 状态条 / NC 连接 / 权限 / 时钟 -->
        <Border DockPanel.Dock="Top" Height="76" Background="{StaticResource Brush.Accent}" Padding="20,0">
            <DockPanel LastChildFill="True">
                <!-- 左上角恒为"菜单"：位置固定，任何页面、任何深度都能按。
                     按下去是把底部软键条换成区域键（再按一次收回），不弹浮层。 -->
                <Button DockPanel.Dock="Left"
                        Command="{Binding ToggleAreaMenuCommand}"
                        ToolTip="{loc:Loc Shell_OpenAreaMenu}"
                        ToolTipService.Placement="Bottom"
                        Padding="16,0"
                        Height="56"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        Style="{StaticResource TopBarDarkButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2630;"
                                   FontSize="26"
                                   Foreground="{StaticResource Brush.OnAccent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Brand}"
                                   FontSize="{StaticResource Size.Brand}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.OnAccent}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 当前页的直达快捷键：常驻，让"Ctrl+数字一键切页"不用翻手册也能被发现 -->
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource Brush.AccentDark}"
                        Height="32" Padding="10,0" Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Loc Nav_ShortcutBadgeHint}"
                        ToolTipService.Placement="Bottom">
                    <TextBlock Text="{Binding CurrentAreaShortcutText}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="15"
                               Foreground="{StaticResource Brush.OnAccentMuted}"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 面包屑：当前在哪一层，一眼可见 -->
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding BreadcrumbText}"
                           FontSize="{StaticResource Size.PageTitle}"
                           Foreground="{StaticResource Brush.OnAccent}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <!-- 已修改 / 运行中只读：两个状态角标，改动与锁定都不靠猜 -->
                <Border DockPanel.Dock="Left"
                        Background="{StaticResource Brush.NextStep}"
                        Height="32" Padding="10,0" Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding CurrentPage.IsDirty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Loc Shell_Modified}"
                               FontSize="15"
                               Foreground="{StaticResource Brush.OnNextStep}"
                               VerticalAlignment="Center" />
                </Border>

                <Border DockPanel.Dock="Left"
                        Background="{StaticResource Brush.AccentDark}"
                        Height="32" Padding="10,0" Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding CurrentPage.IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Loc Shell_ReadOnlyRunning}"
                               FontSize="15"
                               Foreground="{StaticResource Brush.OnAccent}"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.AccentDark}" Height="46" Padding="14,0" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Brush.CurrentStep}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#45C07C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}"
                                       FontSize="16"
                                       Foreground="{StaticResource Brush.OnAccent}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.WarningFill}" Height="46" Padding="14,0" Margin="16,0,0,0"
                            Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Top_OfflineMode}"
                                   FontSize="17"
                                   Foreground="{StaticResource Brush.OnAccent}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border Background="{StaticResource Brush.AccentDark}" Height="46" Padding="14,0" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RoleText}"
                                       FontSize="17"
                                       Foreground="{StaticResource Brush.OnAccent}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UserNameText}"
                                       FontSize="17"
                                       Foreground="{StaticResource Brush.OnAccent}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Button Content="{loc:Loc Users_Manage}" Command="{Binding OpenUserAdminCommand}"
                            Style="{StaticResource SecondaryButton}" Height="46" Margin="10,0,0,0" Padding="14,0"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="{loc:Loc SignIn_SignOut}" Command="{Binding SignOutCommand}"
                            Style="{StaticResource SecondaryButton}" Height="46" Margin="10,0,0,0" Padding="14,0"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding ClockText}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="{StaticResource Size.PageTitle}"
                               Foreground="{StaticResource Brush.OnAccent}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </StackPanel>

                <!-- 中间：页面上下文 + 状态条 -->
                <DockPanel LastChildFill="True">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding CurrentPage.ContextItems}"
                                  VerticalAlignment="Center" Margin="0,0,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LabelResourceKey, Converter={StaticResource LocalizeConverter}}"
                                               FontSize="15"
                                               Foreground="{StaticResource Brush.OnAccentMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="20"
                                               Foreground="{StaticResource Brush.OnAccent}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="46"
                            VerticalAlignment="Center"
                            Padding="16,0"
                            Background="{Binding BannerSeverity, Converter={StaticResource SeverityToBrush}}"
                            BorderThickness="4,0,0,0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#45C07C" />
                        </Border.BorderBrush>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 报警号用白字：浅蓝（OnAccentMuted）在警告棕底上只有 3.9:1、错误红底上 4.3:1。
                                 和后面的文字靠等宽字体区分，不靠变淡。 -->
                            <TextBlock Text="{Binding BannerCode}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="15"
                                       Foreground="{StaticResource Brush.OnAccent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding BannerText}"
                                       FontSize="18"
                                       Foreground="{StaticResource Brush.OnAccent}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- 底部功能条 86：8 个等宽键，最后一个是导航槽。
             页面菜单态时前 7 格原地换成区域键（对齐 Operate 的 MENU SELECT），
             整条换强调色上沿，一眼看出现在按下去是"换页"而不是"干活"。 -->
        <Border DockPanel.Dock="Bottom" Height="86" Padding="14,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.FunctionBar}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAreaMenuOpen}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.AccentDark}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="BorderThickness" Value="0,4,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ItemsControl ItemsSource="{Binding FunctionKeys}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}"
                                IsEnabled="{Binding IsEnabled}"
                                ToolTip="{Binding HintText}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTipService.Placement="Top"
                                Style="{Binding Kind, Converter={StaticResource FunctionKeyStyle}}"
                                Margin="5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ShortcutText}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="{StaticResource Size.Caption}"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding ShortcutText, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid>
            <ContentControl Content="{Binding CurrentPage}"
                            Margin="12"
                            IsEnabled="{Binding IsOverlayOpen, Converter={StaticResource InverseBool}}" />

            <!-- 离开确认：脏页切走时拦一道，三个选择都写清楚后果 -->
            <Grid x:Name="LeaveConfirmOverlay" Background="#B3101418"
                  Visibility="{Binding IsLeaveConfirmOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.CurrentStep}"
                        BorderThickness="3"
                        Width="820"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="32,28">
                    <StackPanel>
                        <TextBlock FontSize="30"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"
                                   Text="{Binding LeaveConfirmPageTitle, Converter={StaticResource LeaveTitle}}" />
                        <TextBlock Text="{loc:Loc Leave_Message}"
                                   FontSize="19"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                            <Button Content="{loc:Loc Leave_Cancel}"
                                    Command="{Binding CancelLeaveCommand}"
                                    Style="{StaticResource DialogPrimaryButton}" />
                            <Button Content="{loc:Loc Leave_Save}"
                                    Command="{Binding SaveAndLeaveCommand}"
                                    Style="{StaticResource DialogButton}"
                                    Visibility="{Binding LeaveConfirmCanSave, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{loc:Loc Leave_Discard}"
                                    Command="{Binding DiscardAndLeaveCommand}"
                                    Style="{StaticResource DialogDangerButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 登录：退不掉的浮层。没登录就什么都不给。 -->
            <Border x:Name="SignInOverlay" Background="#E6101418"
                    Visibility="{Binding IsSignInOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Width="480"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Margin="28">
                        <TextBlock Text="{loc:Loc SignIn_Title}" Style="{StaticResource Text.CardTitle}"
                                   FontSize="24" Margin="0,0,0,20" />

                        <TextBlock Text="{loc:Loc SignIn_UserName}" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding KnownUserNames}" Text="{Binding SignInUserName}"
                                  IsEditable="True" Height="50" FontSize="18" Margin="0,8,0,16" />

                        <!-- 常规登录 -->
                        <StackPanel Visibility="{Binding IsNormalSignIn, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc SignIn_Password}" Style="{StaticResource Text.Label}" />
                            <PasswordBox x:Name="SignInPasswordBox" PasswordChanged="OnSignInPasswordChanged"
                                         Height="50" FontSize="18" Margin="0,8,0,16"
                                         VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- 首次登录：先设一个口令 -->
                        <StackPanel Visibility="{Binding NeedsNewPassword, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc SignIn_NewPassword}" Style="{StaticResource Text.Label}" />
                            <PasswordBox PasswordChanged="OnNewPasswordChanged"
                                         Height="50" FontSize="18" Margin="0,8,0,16"
                                         VerticalContentAlignment="Center" />
                            <TextBlock Text="{loc:Loc SignIn_ConfirmPassword}" Style="{StaticResource Text.Label}" />
                            <PasswordBox PasswordChanged="OnConfirmPasswordChanged"
                                         Height="50" FontSize="18" Margin="0,8,0,16"
                                         VerticalContentAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding SignInMessage}" FontSize="16"
                                   Foreground="{StaticResource Brush.WarningFill}" TextWrapping="Wrap"
                                   Visibility="{Binding SignInMessage, Converter={StaticResource TextToVisibility}}"
                                   Margin="0,0,0,16" />

                        <Button Content="{loc:Loc SignIn_Confirm}" Command="{Binding SignInCommand}"
                                Style="{StaticResource PrimaryButton}" Height="56" IsDefault="True" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- 用户管理：管理员以上才开得出来 -->
            <Border x:Name="UserAdminOverlay" Background="#CC101418"
                    Visibility="{Binding IsUserAdminOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Width="760" Height="560"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Users_Title}" Style="{StaticResource Text.CardTitle}" />
                        </Border>

                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Divider}"
                                BorderThickness="0,1,0,0" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Users_NewUser}" Style="{StaticResource Text.Label}"
                                           Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="48" FontSize="17" Margin="0,0,8,0"
                                             VerticalContentAlignment="Center" />
                                    <PasswordBox Grid.Column="1" PasswordChanged="OnNewUserPasswordChanged"
                                                 Height="48" FontSize="17" Margin="0,0,8,0"
                                                 VerticalContentAlignment="Center" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AssignableRoles}"
                                              SelectedItem="{Binding NewUserRole}"
                                              Height="48" FontSize="17" Margin="0,0,8,0" />
                                    <Button Grid.Column="3" Content="{loc:Loc Users_Create}"
                                            Command="{Binding CreateUserCommand}"
                                            Style="{StaticResource PrimaryButton}" Height="48" Width="100" />
                                </Grid>
                                <TextBlock Text="{loc:Loc Users_PasswordHint}" Style="{StaticResource Text.Label}"
                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="{loc:Loc Users_ResetPassword}"
                                            Command="{Binding ResetUserPasswordCommand}"
                                            Style="{StaticResource SecondaryButton}" Height="52" Width="130"
                                            Margin="0,0,10,0" />
                                    <Button Content="{loc:Loc Users_Delete}" Command="{Binding DeleteUserCommand}"
                                            Style="{StaticResource DialogDangerButton}" Height="52" Width="110"
                                            Margin="0,0,10,0" />
                                    <Button Content="{loc:Loc Users_Close}" Command="{Binding CloseUserAdminCommand}"
                                            Style="{StaticResource SecondaryButton}" Height="52" Width="110" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding UserAccounts}" SelectedItem="{Binding SelectedUserAccount}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Margin="14,8" FontSize="16" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Users_ColumnName}"
                                                    Binding="{Binding UserName}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Users_ColumnRole}"
                                                    Binding="{Binding Role}" Width="180" />
                                <DataGridTemplateColumn Header="{loc:Loc Users_ColumnPasswordSet}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{loc:Loc Users_PasswordSet}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MustSetPassword}" Value="True">
                                                                <Setter Property="Text" Value="{loc:Loc Users_PasswordNotSet}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </DockPanel>
</Window>
