<UserControl x:Class="RollGrinder.App.Views.StepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:views="clr-namespace:RollGrinder.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <TextBlock Text="{loc:Loc Steps_SequenceHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <!-- 两行：下拉框占满一行，"添加工序""校验"平分第二行。新添的工序插在"结束"前面。 -->
                <Grid DockPanel.Dock="Top" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                        按实机的 5 个工序槽分组呈现（外加不占槽的探伤/测量/标记/暂停）。
                        内部仍然是任意排序的若干种工序类型，槽只是分组——
                        操作工在实机上按这 5 个槽想事情，选工序时照这个分组看。
                    -->
                    <ComboBox x:Name="StepTypePicker" SelectedItem="{Binding SelectedStepType}"
                              DisplayMemberPath="DisplayName" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                              Grid.Row="0" Grid.ColumnSpan="3" Height="46" FontSize="17" Margin="0,0,0,8">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource Size.Caption}" FontWeight="Bold"
                                                   Padding="6,6,6,2"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <Button Content="{loc:Loc Steps_AddStep}" Command="{Binding AddStepCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButton}" Grid.Row="1" Grid.Column="0" Height="46" Margin="0,0,4,0" />
                    <!-- 校验：和存程序、下发前同一套检查，结果列在右栏程序卡片下面（第一轮甲方测试 工序 2⑥）。只读也能按。 -->
                    <Button Content="{loc:Loc Steps_Validate}" Command="{Binding ValidateCommand}"
                            Style="{StaticResource SecondaryButton}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="46" Margin="4,0,0,0" />
                </Grid>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Steps_TotalTime}" FontSize="17" />
                        <TextBlock Text="{Binding TotalDurationText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                   FontWeight="Medium" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="48" Padding="12,0" Margin="0,0,0,4" Background="{StaticResource Brush.StepIdle}">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Order}" Width="24" FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="15" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                        <Button Content="{loc:Loc Steps_RemoveStep}" DockPanel.Dock="Right"
                                                Visibility="{Binding CanBeMoved, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RemoveStepCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsReadOnly,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource InverseBool}}"
                                                Style="{StaticResource SecondaryButton}" FontSize="15" Padding="10,2" Height="32" />
                                        <!-- 调顺序：往后、往前各一格（第一轮甲方测试：只能删，不能挪）。 -->
                                        <Button Content="{loc:Loc Steps_MoveStepDown}" DockPanel.Dock="Right"
                                                Visibility="{Binding CanBeMoved, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{loc:Loc Steps_MoveStepDownTip}"
                                                Command="{Binding DataContext.MoveStepDownCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsReadOnly,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource InverseBool}}"
                                                Style="{StaticResource SecondaryButton}" FontSize="15" Width="38" Height="32"
                                                Padding="0" Margin="0,0,6,0" />
                                        <Button Content="{loc:Loc Steps_MoveStepUp}" DockPanel.Dock="Right"
                                                Visibility="{Binding CanBeMoved, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{loc:Loc Steps_MoveStepUpTip}"
                                                Command="{Binding DataContext.MoveStepUpCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsReadOnly,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource InverseBool}}"
                                                Style="{StaticResource SecondaryButton}" FontSize="15" Width="38" Height="32"
                                                Padding="0" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" FontSize="{StaticResource Size.Caption}"
                                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 程序：名字，以及估算时长用的参考辊（不属于程序、不存）。辊号、尺寸、辊形在作业页选。 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <DockPanel>
                                <TextBlock Text="{loc:Loc Program_Header}" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.CardTitle}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource Brush.CurrentStep}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl Background="{StaticResource Brush.GridLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_Name}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_ReferenceBodyLength}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding BodyLengthMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_ReferenceDiameter}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding NominalDiameterMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- 校验结果：紧跟在程序卡片（标题右侧是状态）下面，按"校验""保存"之后不用往下翻就看得到。 -->
                <ItemsControl ItemsSource="{Binding Violations}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                <TextBlock Text="{Binding ParameterText}" Width="260" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                                <TextBlock Text="{Binding ReasonText}" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Order}" FontFamily="{StaticResource Font.Mono}"
                                                       Style="{StaticResource Text.CardTitle}" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.CardTitle}"
                                                       Margin="12,0,0,0" Foreground="{StaticResource Brush.TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Parameters}"
                                                  Background="{StaticResource Brush.GridLine}"
                                                  ItemTemplate="{StaticResource ParameterCellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Steps_CompensationHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding CompensationSettings}" Background="{StaticResource Brush.GridLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ParameterCell}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Parameter}" FontSize="26" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- 程序步骤（自动磨削前取舍）：八个开关，本台机床做不了的压暗禁掉 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Steps_ProgramOptionsHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ProgramOptions}"
                                      Margin="12"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsOn}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="{Binding UnavailableHint}"
                                                  ToolTipService.Placement="Right"
                                                  Height="42"
                                                  Margin="2"
                                                  HorizontalContentAlignment="Left"
                                                  Style="{StaticResource ProgramOptionToggle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" Margin="10,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ButtonBorder}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 程序库 -->
        <Border Grid.ColumnSpan="2" Background="#CC101418"
                Visibility="{Binding IsProgramLibraryOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="720" Height="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Program_Library}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="14">
                        <Button Content="{loc:Loc Program_LibraryOpen}" Command="{Binding LoadProgramCommand}"
                                Style="{StaticResource PrimaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Program_LibraryDelete}" Command="{Binding DeleteProgramCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Program_LibraryClose}" Command="{Binding CloseProgramLibraryCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Program_LibraryEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgramLibraryEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding ProgramLibraryEntries}" SelectedItem="{Binding SelectedProgramEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Margin="14,8" FontSize="16" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Program_ColumnName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Program_ColumnSteps}" Binding="{Binding StepCount}" Width="90" />
                            <DataGridTextColumn Header="{loc:Loc Program_ColumnModified}"
                                                Binding="{Binding ModifiedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <!-- 另存为的命名框：盖在最上面。 -->
        <views:NamePromptOverlay Grid.ColumnSpan="2" DataContext="{Binding NamePrompt}" />
</Grid>
</UserControl>
