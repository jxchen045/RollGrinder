<UserControl x:Class="RollGrinder.App.Views.StepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:views="clr-namespace:RollGrinder.App.Views">
    <Grid>
        <Grid.Resources>
            <!-- 轧辊数据子视图：这支辊本身的登记项，与工艺参数分开 -->
            <Style x:Key="RollDataPanel" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActiveSubViewKey}" Value="SubView_RollData">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <TextBlock Text="{loc:Loc Steps_SequenceHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <!-- 两行：下拉框占满一行，两个按钮平分第二行。一行放不下——左栏只有约 345 px，按钮字会被截断。 -->
                <Grid DockPanel.Dock="Top" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                        按实机的 5 个工序槽分组呈现（外加不占槽的探伤/测量/标记/暂停）。
                        内部仍然是任意排序的若干种工序类型，槽只是分组——
                        操作工在实机上按这 5 个槽想事情，选工序时照这个分组看。
                    -->
                    <ComboBox x:Name="StepTypePicker" SelectedItem="{Binding SelectedStepType}"
                              DisplayMemberPath="DisplayName" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                              Grid.Row="0" Grid.ColumnSpan="2" Height="46" FontSize="17" Margin="0,0,0,8">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Padding="6,6,6,2"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <Button Content="{loc:Loc Steps_AddStep}" Command="{Binding AddStepCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButton}" Grid.Row="1" Grid.Column="0" Height="46" Margin="0,0,4,0" />
                    <Button Content="{loc:Loc Steps_NewJob}" Command="{Binding NewJobCommand}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButton}" Grid.Row="1" Grid.Column="1" Height="46" Margin="4,0,0,0" />
                </Grid>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Steps_TotalTime}" FontSize="17" />
                        <TextBlock Text="{Binding TotalDurationText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                   FontWeight="Medium" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="48" Padding="12,0" Margin="0,0,0,4" Background="{StaticResource Brush.StepIdle}">
                                    <DockPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Order}" Width="24" FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="15" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                        <Button Content="{loc:Loc Steps_RemoveStep}" DockPanel.Dock="Right"
                                                Command="{Binding DataContext.RemoveStepCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsReadOnly,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource InverseBool}}"
                                                Style="{StaticResource SecondaryButton}" FontSize="15" Padding="10,2" Height="32" />
                                        <TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" FontSize="14"
                                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Steps_RollHeader}" Style="{StaticResource Text.CardTitle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.CardTitle}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource Brush.CurrentStep}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl Background="{StaticResource Brush.GridLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Job_JobIdLabel}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Job_RollIdLabel}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding RollId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Job_BodyLengthLabel}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding BodyLengthMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Job_DiameterLabel}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding NominalDiameterMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_Name}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Job_ProfileTypeLabel}" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding ProfileTypeKeys}" SelectedItem="{Binding SelectedProfileTypeKey}"
                                              IsEnabled="{Binding CanEditInlineProfile}"
                                              Height="46" FontSize="18" Margin="0,8,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource LocalizeConverter}, ConverterParameter=ProfileType_}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Steps_ProfileSource}" Style="{StaticResource Text.Label}" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="{loc:Loc Steps_ClearProfile}"
                                                Command="{Binding ClearProfileSelectionCommand}"
                                                Visibility="{Binding UsesLibraryProfile, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource SecondaryButton}" Height="46" Width="96" Margin="8,0,0,0" />
                                        <TextBlock VerticalAlignment="Center" FontSize="17" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{loc:Loc Steps_ProfileInline}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesLibraryProfile}" Value="True">
                                                            <Setter Property="Text" Value="{Binding SelectedProfileName}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Job_ProfileParametersHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ProfileParameters}"
                                      Background="{StaticResource Brush.GridLine}"
                                      IsEnabled="{Binding CanEditInlineProfile}"
                                      ItemTemplate="{StaticResource ParameterCellTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesLibraryProfile}" Value="True">
                                            <!-- 辊形来自库里，这一格压暗：留在原位，只是按不动。 -->
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Order}" FontFamily="{StaticResource Font.Mono}"
                                                       Style="{StaticResource Text.CardTitle}" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.CardTitle}"
                                                       Margin="12,0,0,0" Foreground="{StaticResource Brush.TextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Parameters}"
                                                  Background="{StaticResource Brush.GridLine}"
                                                  ItemTemplate="{StaticResource ParameterCellTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Steps_CompensationHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding CompensationSettings}" Background="{StaticResource Brush.GridLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ParameterCell}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Parameter}" FontSize="26" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- 程序步骤（自动磨削前取舍）：八个开关，本台机床做不了的压暗禁掉 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Steps_ProgramOptionsHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding ProgramOptions}"
                                      Margin="12"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsOn}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="{Binding UnavailableHint}"
                                                  Height="42"
                                                  Margin="2"
                                                  HorizontalContentAlignment="Left"
                                                  Style="{StaticResource ProgramOptionToggle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" Margin="10,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ButtonBorder}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Violations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                <TextBlock Text="{Binding ParameterText}" Width="260" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                                <TextBlock Text="{Binding ReasonText}" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 程序库 -->
        <Border Grid.ColumnSpan="2" Background="#CC101418"
                Visibility="{Binding IsProgramLibraryOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="720" Height="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Program_Library}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="14">
                        <Button Content="{loc:Loc Program_LibraryOpen}" Command="{Binding LoadProgramCommand}"
                                Style="{StaticResource PrimaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Program_LibraryDelete}" Command="{Binding DeleteProgramCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Program_LibraryClose}" Command="{Binding CloseProgramLibraryCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Program_LibraryEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProgramLibraryEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding ProgramLibraryEntries}" SelectedItem="{Binding SelectedProgramEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Margin="14,8" FontSize="16" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Program_ColumnName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Program_ColumnSteps}" Binding="{Binding StepCount}" Width="90" />
                            <DataGridTextColumn Header="{loc:Loc Program_ColumnModified}"
                                                Binding="{Binding ModifiedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <!-- 辊形库：在这里选一条辊形给本支作业用 -->
        <Border Grid.ColumnSpan="2" Background="#CC101418"
                Visibility="{Binding IsProfileLibraryOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="720" Height="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Profile_Library}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="14">
                        <Button Content="{loc:Loc Steps_UseThisProfile}" Command="{Binding UseProfileFromLibraryCommand}"
                                Style="{StaticResource PrimaryButton}" Height="52" Width="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Profile_LibraryClose}" Command="{Binding CloseProfileLibraryCommand}"
                                Style="{StaticResource SecondaryButton}" Height="52" Width="110" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Profile_LibraryEmpty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileLibraryEntries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding ProfileLibraryEntries}" SelectedItem="{Binding SelectedProfileEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Margin="14,8" FontSize="16" RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnName}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnType}" Binding="{Binding ProfileTypeKey}" Width="140" />
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnSegments}" Binding="{Binding SegmentCount}" Width="80" />
                            <DataGridTextColumn Header="{loc:Loc Profile_LibraryColumnModified}"
                                                Binding="{Binding ModifiedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>
    
        <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource RollDataPanel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}" Height="56">
                    <TextBlock Text="{loc:Loc Steps_RollDataHeader}" Style="{StaticResource Text.CardTitle}"
                               VerticalAlignment="Center" />
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="20,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Steps_SaveRollData}" Command="{Binding SaveRollDataCommand}"
                                Style="{StaticResource PrimaryButton}" Height="46" Padding="24,0" />
                        <TextBlock Text="{loc:Loc RollData_TotalWeight}" Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" Margin="24,0,8,0" />
                        <TextBlock Text="{Binding TotalWeightText}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="18" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Accent}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" Margin="24,0,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding RollData}" Margin="20,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Label}" Width="240" FontSize="17"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ValueTextBox}" Width="200"
                                         HorizontalAlignment="Left" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
</Grid>
</UserControl>
