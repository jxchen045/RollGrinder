<UserControl x:Class="RollGrinder.App.Views.StepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{ctl:Px 360}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <TextBlock Text="{loc:Loc Steps_SequenceHeader}" Style="{StaticResource Text.CardTitle}" />
                </Border>

                <!-- 插入、删除、调序、复制都在右侧竖向软键上（修改稿原则 1），这里只留"校验"。
                     和存程序、下发前同一套检查，结果列在右栏程序卡片下面。只读也能按。 -->
                <StackPanel DockPanel.Dock="Top" Margin="8">
                    <Button Content="{loc:Loc Steps_Validate}" Command="{Binding ValidateCommand}"
                            Style="{StaticResource SecondaryButton}" Height="46" />
                    <TextBlock Text="{loc:Loc Steps_EditOnVerticalKeys}" Style="{StaticResource Text.Label}"
                               TextWrapping="Wrap" Margin="6,8,6,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}"
                        BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14">
                    <DockPanel>
                        <TextBlock Text="{loc:Loc Steps_TotalTime}" FontSize="17" />
                        <TextBlock Text="{Binding TotalDurationText}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                   FontWeight="Medium" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>

                <!-- 工序序列：上下键移动选中，选中的那道在右栏显示简图与参数。 -->
                <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                         Margin="8,0,8,8" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="46" Padding="10,0">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Order}" Width="26" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="{StaticResource Size.Caption}" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DurationText}" DockPanel.Dock="Right" FontSize="{StaticResource Size.Caption}"
                                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 程序：名字，以及估算时长用的参考辊（不属于程序、不存）。辊号、尺寸、辊形在作业页选。 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <DockPanel>
                                <TextBlock Text="{loc:Loc Program_Header}" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.CardTitle}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource Brush.CurrentStep}" />
                            </DockPanel>
                        </Border>
                        <ItemsControl Background="{StaticResource Brush.GridLine}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_Name}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <!-- 适用轧辊类型（横键"适用类型 ▸"改）：作业核对按它拦；不限时任何辊都能用。 -->
                                    <TextBlock Text="{loc:Loc Program_ApplicableKind}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding ApplicableKindText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_ApplicableMaterial}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ApplicableMaterial, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <!-- 估时用的参考辊身长度：程序与具体轧辊无关，作业里按那支辊重算。 -->
                                    <TextBlock Text="{loc:Loc Program_ReferenceBodyLength}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding BodyLengthMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_ReferenceDiameter}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding NominalDiameterMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ParameterCell}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Program_TotalStock}" Style="{StaticResource Text.Label}" />
                                    <TextBox x:Name="TotalStockBox" Text="{Binding TotalStockText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ValueTextBox}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- 跨工序提示（修改稿 5.3）：余量对账、磨完有没有测量、余量是否倒过来。只提示，不挡保存。 -->
                <ItemsControl x:Name="ProgramHintList" ItemsSource="{Binding ProgramHints}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="17" Margin="4,0,0,6" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.WarningFill}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 校验结果：紧跟在程序卡片（标题右侧是状态）下面，按"校验""保存"之后不用往下翻就看得到。 -->
                <ItemsControl ItemsSource="{Binding Violations}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                <TextBlock Text="{Binding ParameterText}" Width="{ctl:Px 260}" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                                <TextBlock Text="{Binding ReasonText}" FontSize="17"
                                           Foreground="{StaticResource Brush.CurrentStep}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 选中的那道工序：简图（当前参数在图上高亮）+ 参数格 + 一行说明。 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding SelectedStep}"
                        Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Order}" FontFamily="{StaticResource Font.Mono}"
                                           Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.CardTitle}"
                                           Margin="12,0,0,0" Foreground="{StaticResource Brush.TextPrimary}" />
                            </StackPanel>
                        </Border>
                        <!-- 说明行：光标所在参数的含义、单位、允许范围。 -->
                        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.HeaderFill}" Padding="14,10"
                                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding DataContext.ParameterHelpText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{ctl:Px 440}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 简图：光标在哪个参数，图上哪个量就亮（修改稿原则 2）。 -->
                            <ctl:StepDiagram Grid.Column="0" Margin="10" Height="{ctl:Px 220}" VerticalAlignment="Top"
                                             StepTypeKey="{Binding StepTypeKey}"
                                             HighlightedParameterKey="{Binding DataContext.FocusedParameterKey,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Parameters}"
                                          Background="{StaticResource Brush.GridLine}"
                                          ItemTemplate="{StaticResource ParameterCellTemplate}"
                                          IsEnabled="{Binding DataContext.IsReadOnly,
                                              RelativeSource={RelativeSource AncestorType=UserControl},
                                              Converter={StaticResource InverseBool}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 程序步骤（自动磨削前取舍）：八个开关，本台机床做不了的压暗禁掉 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                            <TextBlock Text="{loc:Loc Steps_ProgramOptionsHeader}" Style="{StaticResource Text.CardTitle}" />
                        </Border>
                        <ItemsControl x:Name="ProgramOptionsList" ItemsSource="{Binding ProgramOptions}"
                                      Margin="12"
                                      IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBool}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsOn}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="{Binding UnavailableHint}"
                                                  ToolTipService.Placement="Right"
                                                  Height="42"
                                                  Margin="2"
                                                  HorizontalContentAlignment="Left"
                                                  Style="{StaticResource ProgramOptionToggle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" Margin="10,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ButtonBorder}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Body}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 另存为的命名框：盖在最上面。 -->
        <views:NamePromptOverlay Grid.ColumnSpan="2" DataContext="{Binding NamePrompt}" />
</Grid>
</UserControl>
