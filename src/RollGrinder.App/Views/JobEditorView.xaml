<UserControl x:Class="RollGrinder.App.Views.JobEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:views="clr-namespace:RollGrinder.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="{loc:Loc Job_Header}" FontSize="20" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Job_JobIdLabel}" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Job_RollIdLabel}" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding RollId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Job_BodyLengthLabel}" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BodyLengthMmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,8" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc Job_DiameterLabel}" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NominalDiameterMmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Job_ProfileTypeLabel}" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding ProfileTypeKeys}"
                          SelectedItem="{Binding SelectedProfileTypeKey}"
                          Margin="0,0,16,8" />
            </Grid>

            <TextBlock Text="{loc:Loc Job_ProfileParametersHeader}" FontSize="16" Margin="0,12,0,8" />
            <views:ParameterEditor DataContext="{Binding ProfileParameters}" />

            <TextBlock Text="{loc:Loc Job_StepsHeader}" FontSize="16" Margin="0,16,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="200" ItemsSource="{Binding StepTypeKeys}" SelectedItem="{Binding SelectedStepTypeKey}" />
                <Button Content="{loc:Loc Job_AddStepButton}" Command="{Binding AddStepCommand}" Margin="8,0,0,0" Padding="16,6" />
                <Button Content="{loc:Loc Job_NewJobButton}" Command="{Binding NewJobCommand}" Margin="8,0,0,0" Padding="16,6" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#40000000" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Order}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}" Margin="12,0,0,0" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Content="{loc:Loc Job_RemoveStepButton}"
                                            Command="{Binding DataContext.RemoveStepCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="16,0,0,0"
                                            Padding="12,2" />
                                </StackPanel>
                                <views:ParameterEditor DataContext="{Binding Parameters}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                <Button Content="{loc:Loc Job_ValidateButton}" Command="{Binding ValidateCommand}" Padding="20,8" />
                <Button Content="{loc:Loc Job_DownloadButton}" Command="{Binding DownloadCommand}" Margin="12,0,0,0" Padding="20,8" />
                <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Violations}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding ParameterText}" Width="260" Foreground="#C62828" />
                            <TextBlock Text="{Binding ReasonText}" Foreground="#C62828" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
