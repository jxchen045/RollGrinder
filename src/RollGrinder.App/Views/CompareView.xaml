<UserControl x:Class="RollGrinder.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        对比（设计稿 v4 5.5.1 / 5.6.1）。DataContext 是 CompareViewModel。
        左：逐项 A / B（不同的加粗、浅琥珀底；竖键切"只看不同 / 全部"）；右：两条辊形叠图，以辊身中心为 0（A 实线、B 虚线）。
    -->
    <Grid Background="{StaticResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{loc:Loc Compare_Title}" Style="{StaticResource Text.CardTitle}" />
                    </DockPanel>
                </Border>
                <Grid DockPanel.Dock="Top" Margin="12,6,12,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Compare_ColItem}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding TitleA}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding TitleB}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="12,0,12,8">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="0,6" BorderBrush="{StaticResource Brush.GridLine}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ItemText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <TextBlock x:Name="A" Grid.Column="1" Text="{Binding AText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="B" Grid.Column="2" Text="{Binding BText}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Differs}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.WarningRowFill}" />
                                    <Setter TargetName="A" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="B" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="━ " Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding TitleA}" Style="{StaticResource Text.CardTitle}" Margin="0,0,24,0" />
                        <TextBlock Text="╍ " Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Text="{Binding TitleB}" Style="{StaticResource Text.CardTitle}" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Compare_NoCurve}" Style="{StaticResource Text.Label}" Margin="14,8"
                           Visibility="{Binding HasCurve, Converter={StaticResource InverseBoolVisibility}}" />
                <plot:WpfPlot x:Name="Plot" Margin="6" Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
