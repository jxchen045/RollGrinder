<UserControl x:Class="RollGrinder.App.Views.MeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Measurement_Header}" FontSize="20" Margin="0,0,0,12" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{loc:Loc Job_JobIdLabel}" VerticalAlignment="Center" />
                <TextBox Text="{Binding JobId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{loc:Loc Measurement_CaptureButton}" Command="{Binding CapturePointCommand}" Padding="16,6" />
                <Button Content="{loc:Loc Measurement_ClearButton}" Command="{Binding ClearPointsCommand}" Margin="8,0,0,0" Padding="16,6" />
                <Button Content="{loc:Loc Measurement_SaveButton}" Command="{Binding SaveCommand}" Margin="8,0,0,0" Padding="16,6" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{loc:Loc Measurement_ComputeButton}" Command="{Binding ComputeCompensationCommand}" Padding="16,8" HorizontalAlignment="Left" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Measurement_WorstDeviationLabel}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorstDeviationText}" FontFamily="Consolas" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Measurement_PeakToValleyLabel}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PeakToValleyText}" FontFamily="Consolas" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Measurement_ToleranceLabel}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ToleranceText}" FontFamily="Consolas" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Measurement_VerdictLabel}" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:Loc Measurement_OutOfTolerance}" />
                                <Setter Property="Foreground" Value="#C62828" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWithinTolerance}" Value="True">
                                        <Setter Property="Text" Value="{loc:Loc Measurement_WithinTolerance}" />
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Opacity="0.8" />
            </StackPanel>

            <DataGrid ItemsSource="{Binding Points}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Measurement_PositionColumn}" Binding="{Binding BodyPositionText}" Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Measurement_DiameterColumn}" Binding="{Binding DiameterText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Measurement_ChartHeader}" FontSize="16" Margin="0,0,0,8" />
            <plot:WpfPlot x:Name="ProfilePlot" />
        </DockPanel>
    </Grid>
</UserControl>
