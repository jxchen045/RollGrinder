<UserControl x:Class="RollGrinder.App.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RollGrinder.App.Localization"
             xmlns:ctl="clr-namespace:RollGrinder.App.Controls"
             xmlns:views="clr-namespace:RollGrinder.App.Views"
             xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <!--
        方案列表（设计稿 v4 5.5.1）：上面是这支辊的方案（★ 当前、用了几次、来源、名义长度），
        下面左是选中方案的摘要，右是它的辊形（横轴以辊身中心为 0）。DataContext 是 PlansViewModel。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource ActiveCardHeader}">
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Text.CardTitle}" />
                </Border>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource DataTable}" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Plan_ColNo}" Binding="{Binding NoText}" Width="0.6*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColName}" Binding="{Binding NameText}" Width="2.4*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColPurpose}" Binding="{Binding PurposeText}" Width="0.7*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColSource}" Binding="{Binding SourceText}" Width="2*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColConsistency}" Binding="{Binding ConsistencyText}" Width="0.9*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColNominal}" Binding="{Binding NominalText}" Width="0.7*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColUsed}" Binding="{Binding UsedText}" Width="0.5*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColLast}" Binding="{Binding LastText}" Width="0.7*" />
                        <DataGridTextColumn Header="{loc:Loc Plan_ColCreated}" Binding="{Binding CreatedText}" Width="1.1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding DetailRows}" Margin="14,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" Width="{x:Static ctl:LayoutProfile.LabelColumnWidth}" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <TextBlock Text="{loc:Loc Plan_ProfileHeader}" Style="{StaticResource Text.CardTitle}" />
                    </Border>
                    <plot:WpfPlot x:Name="PreviewPlot" Margin="6" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- 复制来（设计稿 v4 5.5.5）：与作业换方案同一个选方案子视图，盖住整页。 -->
        <views:PlanPickerView Grid.RowSpan="3" DataContext="{Binding Picker}"
                              Visibility="{Binding DataContext.IsPicking, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

        <!-- 对比（设计稿 v4 5.5.1）：盖住整页，竖键 8 返回。 -->
        <views:CompareView Grid.RowSpan="3" DataContext="{Binding Compare}"
                           Visibility="{Binding DataContext.IsCompareOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />

        <!-- 新方案名、改名（3 种弹出框之一）。 -->
        <views:NamePromptOverlay Grid.RowSpan="3" DataContext="{Binding NamePrompt}" />
    </Grid>
</UserControl>
