<!--
  控件样式：卡片、卡片标题栏、参数网格单元、三类按钮、输入框、列表行。
  版面规则见 docs/design/README.md。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:RollGrinder.App.Converters"
                    xmlns:ctl="clr-namespace:RollGrinder.App.Controls">

  <conv:StepStateToBackgroundConverter x:Key="StepStateToBackground" />
  <conv:StepStateToForegroundConverter x:Key="StepStateToForeground" />
  <conv:EnumEqualsConverter x:Key="EnumEquals" />
  <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
  <conv:FunctionKeyStyleConverter x:Key="FunctionKeyStyle" />
  <conv:LocalizeConverter x:Key="LocalizeConverter" />
  <conv:FractionToWidthConverter x:Key="FractionToWidth" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
  <conv:InverseBooleanConverter x:Key="InverseBool" />
  <conv:TextToVisibilityConverter x:Key="TextToVisibility" />
  <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
  <conv:LeaveTitleConverter x:Key="LeaveTitle" />

  <!-- 窗口（最终稿 4.3）：窗口底 #EBF0F6 + 1px 描边；数值格是白的，从窗口底上跳出来。 -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Background}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- 窗口标题栏：高 44，灰底 #C6CBD1（非当前窗口），底部 1px 分隔线 -->
  <Style x:Key="CardHeader" TargetType="Border">
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{StaticResource Brush.HeaderFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextSecondary}" />
  </Style>

  <!-- 当前窗口的标题栏：青底白字（最终稿 4.3）。 -->
  <Style x:Key="ActiveCardHeader" TargetType="Border" BasedOn="{StaticResource CardHeader}">
    <Setter Property="Background" Value="{StaticResource Brush.Active}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Active}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.OnAccent}" />
  </Style>

  <!-- 参数网格：容器铺网格线色，单元格白底，靠 1px 间隙形成分隔线 -->
  <Style x:Key="ParameterGrid" TargetType="ItemsControl">
    <Setter Property="Background" Value="{StaticResource Brush.GridLine}" />
  </Style>

  <Style x:Key="ParameterCell" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="Margin" Value="0,0,1,1" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!--
    键盘焦点框：内白外黑两道细框，深色、浅色按钮上都看得清。
    只在用键盘（Tab / 方向键）移动焦点时出现，鼠标、触摸点击不出现——不干扰触摸操作。
  -->
  <Style x:Key="KeyboardFocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid SnapsToDevicePixels="True">
            <Rectangle Margin="-4" Stroke="{StaticResource Brush.FocusRing}" StrokeThickness="2" />
            <Rectangle Margin="-2" Stroke="{StaticResource Brush.Surface}" StrokeThickness="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    次级按钮：白底描边，功能条与卡片内通用。也是所有按钮共用的模板。

    触摸屏没有悬停（最终稿 4.6：去掉全部悬停效果），只有常态、按下、禁用。
    按下色由各样式经 ctl:ButtonStates 声明。模板的做法是**叠层**：
    底色、按下色、禁用色各是一层 Border，颜色用 TemplateBinding 一次绑死，
    触发器只切换哪一层可见——触发器里不放任何 Binding（第三轮现场"闪烁"问题的教训）。
    最底下垫一层透明的 Root：无论哪一层显示什么颜色，整块按钮永远接得住点击。
  -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.SurfacePressed}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="PressedLayer" Visibility="Hidden"
                    Background="{TemplateBinding ctl:ButtonStates.PressedBackground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <!-- 禁用：中性灰底灰字，按钮留在原位不跳动；不用半透明，红键不会变成像"警告"的粉色。 -->
            <Border x:Name="DisabledLayer" Visibility="Hidden"
                    Background="{StaticResource Brush.DisabledFill}"
                    BorderBrush="{StaticResource Brush.DisabledBorder}"
                    BorderThickness="1" />
            <ContentPresenter x:Name="Content"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PressedLayer" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PressedLayer" Property="Visibility" Value="Hidden" />
              <Setter TargetName="DisabledLayer" Property="Visibility" Value="Visible" />
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledText}" />
            </Trigger>
            <!-- 软键按不了：灰字、留在原位，但照样接得住点击——外壳在对话行说明原因（最终稿 4.4）。 -->
            <Trigger Property="ctl:ButtonStates.IsUnavailable" Value="True">
              <Setter TargetName="PressedLayer" Property="Visibility" Value="Hidden" />
              <Setter TargetName="DisabledLayer" Property="Visibility" Value="Visible" />
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Brush.DisabledText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!--
        分段选择键（参数格里的选项）、横键（正显示着的功能组）的"当前"：青底白字（最终稿 4.4）。
        描边只换颜色不换粗细——粗细一变内容就挪一个像素，看起来像跳。
      -->
      <Trigger Property="ctl:ButtonStates.IsSelected" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Active}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Active}" />
        <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.ActivePressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 实心按钮的悬停 / 按下：往深里走，白字对比度只升不降。 -->
  <Style x:Key="FilledAccentStates" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.AccentPressed}" />
  </Style>

  <!-- 主按钮：实心强调色 -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FilledAccentStates}" />

  <!-- 启动这类"开始干活"的键用绿色 -->
  <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource Brush.Normal}" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.NormalPressed}" />
  </Style>

  <!-- 复位、急停这类危险动作用红色 -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource Brush.CurrentStep}" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.CurrentStepPressed}" />
  </Style>

  <!--
    手动页按钮矩阵的一格。四种样子：
    可按 / 禁用（tagmap 未登记或机床在忙，ToolTip 说明原因）/ 待确认（红底，按第二下才真发）；
    保持型动作开着时点亮。禁用时按钮留在原位只是变灰——键位不跳动，手的肌肉记忆不作废。
  -->
  <DataTemplate x:Key="MachineActionTemplate">
    <Button Content="{Binding Label}"
            Command="{Binding Command}"
            IsEnabled="{Binding IsEnabled}"
            ToolTip="{Binding DisabledHint}"
            ToolTipService.Placement="Top"
            Height="56"
            Margin="4">
      <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
              <Setter Property="Background" Value="{StaticResource Brush.Normal}" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.NormalPressed}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAwaitingConfirmation}" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
              <Setter Property="Background" Value="{StaticResource Brush.CurrentStep}" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.CurrentStepPressed}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
    </Button>
  </DataTemplate>

  <!--
    程序步骤的开关。左边那个方块就是"勾"：选中时填成强调色。
    做不了的项禁用后整行压暗，ToolTip 说明缺什么。
  -->
  <Style x:Key="ProgramOptionToggle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.SelectionFill}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.DisabledFill}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.DisabledBorder}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    软键（最终稿 4.1、4.4）：横键 200×74、竖键 200×88，浅灰键面深字，最多两行。
    按下的功能组、区域菜单里的当前区域青底白字；第 7 格取消深红、第 8 格确认深绿；帮助模式黄底。
    "« 返回""≡▸"和普通键同一个样子——对齐 Operate，它们就是软键，不是另一类东西。
  -->
  <Style x:Key="SoftKeyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Background" Value="{StaticResource Brush.Key}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <!-- 上下不留内边距：紧凑档位的键只有 54 px 高，名称 + 快捷键两行要 50 px，留 4 px 就切掉一截（内容本来就居中）。 -->
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.KeyPressed}" />
  </Style>

  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}" />

  <Style x:Key="AreaMenuKeyButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}" />

  <Style x:Key="AreaMenuKeyCurrentButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.Active}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Active}" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.ActivePressed}" />
  </Style>

  <Style x:Key="CancelKeyButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.Cancel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Cancel}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.CancelPressed}" />
  </Style>

  <Style x:Key="ConfirmKeyButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.Confirm}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Confirm}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.ConfirmPressed}" />
  </Style>

  <Style x:Key="HelpKeyButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
    <Setter Property="Background" Value="{StaticResource Brush.HelpKey}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.HelpBorder}" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.HelpKeyPressed}" />
  </Style>

  <!-- 外壳深色区（左栏、功能键块、区域 / 方式方块）上的键：深底白字。 -->
  <Style x:Key="ShellDarkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.LeftBarKey}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.Tile}" />
  </Style>

  <Style x:Key="ShellTileButton" TargetType="Button" BasedOn="{StaticResource ShellDarkButton}">
    <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.LeftBarKey}" />
  </Style>

  <!-- 标题行上可点的字（报警、用户）：和标题行同底，按下变深一点。 -->
  <Style x:Key="TitleRowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Background" Value="{StaticResource Brush.TitleRow}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.KeyPressed}" />
  </Style>

  <!-- 路径条上的"« 返回 xxx"。 -->
  <Style x:Key="PathBackButton" TargetType="Button" BasedOn="{StaticResource SoftKeyButton}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- 确认框里的按钮 -->
  <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Height" Value="64" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>

  <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.AccentPressed}" />
  </Style>

  <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="Background" Value="{StaticResource Brush.CurrentStep}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ctl:ButtonStates.PressedBackground" Value="{StaticResource Brush.CurrentStepPressed}" />
  </Style>

  <!-- 切换格（少的选项、参数格里的选项）：高 54，戴手套也点得准（最终稿 4.6，旧版 36 px 点不准）。 -->
  <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="18,0" />
    <!-- 几个选项平分一格宽：字放不下（紧凑档位、英文"Semi-closed"）就整体缩小，不切字。 -->
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Viewbox StretchDirection="DownOnly">
            <TextBlock Text="{Binding}" />
          </Viewbox>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- 数值输入框。运行中（页面 IsReadOnly）自动转只读：能看能选，不能改。 -->
  <Style x:Key="ValueTextBox" TargetType="TextBox">
    <Setter Property="IsReadOnly"
            Value="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Size.DataRow}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ctl:TouchInput.TapToEdit" Value="True" />
    <Style.Triggers>
      <!-- 点一下选中：当前格青底（最终稿 4.5）；再点一下弹数字键盘。 -->
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.FocusField}" />
      </Trigger>
      <!-- 会马上影响机床、还没确认写入的值标红（最终稿 4.5）。 -->
      <Trigger Property="ctl:TouchInput.IsPending" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.PendingValue}" />
        <Setter Property="FontWeight" Value="Bold" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    参数网格里的一格。数值/文本给输入框，开关与选项给一排分段按钮——
    界面完全按 ParameterSchema 生成，新增一类辊形或工序不动这里。
    互斥参数（连续进给 / 周期进给）里没生效的那格压暗并禁掉，位置保留不跳动。
  -->
  <DataTemplate x:Key="ParameterCellTemplate">
    <Border>
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource ParameterCell}">
          <Style.Triggers>
            <!-- 不适用：灰底 + 格内控件禁用态。不用半透明——40% 透明时标签对比度只剩约 2:1。 -->
            <DataTrigger Binding="{Binding IsApplicable}" Value="False">
              <Setter Property="Background" Value="{StaticResource Brush.DisabledFill}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <StackPanel IsEnabled="{Binding IsApplicable}">
        <!-- 名称和单位在同一个 TextBlock 里：格子窄（紧凑档位、英文）时整体折行，而不是横排着被切掉。 -->
        <TextBlock Style="{StaticResource Text.Label}">
          <Run Text="{Binding Label, Mode=OneWay}" />
          <Run Text="{Binding UnitText, Mode=OneWay}" />
        </TextBlock>

        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ValueTextBox}"
                 Margin="0,6,0,0"
                 ctl:TouchInput.IsNumeric="{Binding IsNumber, Mode=OneTime}"
                 ctl:TouchInput.Minimum="{Binding Minimum, Mode=OneTime}"
                 ctl:TouchInput.Maximum="{Binding Maximum, Mode=OneTime}"
                 ctl:TouchInput.Caption="{Binding Label, Mode=OneTime}"
                 ctl:TouchInput.Hint="{Binding HintText, Mode=OneWay}"
                 Visibility="{Binding IsEditableText, Converter={StaticResource BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Choices}"
                      Margin="0,6,0,0"
                      Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,6,0"
                      Style="{StaticResource SegmentButton}" Height="44" Padding="4,0"
                      ctl:ButtonStates.IsSelected="{Binding IsSelected}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding ErrorText}"
                   FontSize="{StaticResource Size.Caption}"
                   Foreground="{StaticResource Brush.CurrentStep}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!--
    数据表（报警事件、对中结果……）：表头灰底、只留横线、行高 56（最终稿 4.6，手指点得准）、隔行浅底，
    选中行用浅青 #A9DCEC 而不是系统蓝。
    WPF 默认表格是竖线网格 + 系统蓝选中，和其余界面不是一套。
  -->
  <Style x:Key="DataTableHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Brush.HeaderFill}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="DataTableCell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.SelectionFill}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DataTable" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.GridLine}" />
    <Setter Property="RowHeight" Value="56" />
    <Setter Property="FontSize" Value="{StaticResource Size.Label}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="RowBackground" Value="{StaticResource Brush.Surface}" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.RowAlternate}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataTableHeader}" />
    <Setter Property="CellStyle" Value="{StaticResource DataTableCell}" />
  </Style>

  <!-- 数据行：左标签右数值，底部细分隔线 -->
  <Style x:Key="DataRowBorder" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.PlotGridMinor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,11" />
  </Style>

  <!-- 状态灯（修改稿 5.5 状态带、5.6 手动页到位显示）：开为绿、关为灰、读不到画虚框。 -->
  <DataTemplate x:Key="StatusLampTemplate">
    <!-- 文字放在填色的 Border 里面：对比度检查认得出底色（并排叠放时它只看得到页面底色）。 -->
    <!-- 两行字（名称 + 状态）要约 50 px，原来的 46 把状态那行切掉一截。 -->
    <Grid Margin="0,0,8,0" MinWidth="104" Height="54">
      <Rectangle x:Name="LampDash" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5"
                 StrokeDashArray="3 2" Visibility="Collapsed" />
      <Border x:Name="LampFill" Background="{StaticResource Brush.StepIdle}">
        <StackPanel Margin="10,2" VerticalAlignment="Center">
          <TextBlock x:Name="LampLabel" Text="{Binding Label}" FontSize="{StaticResource Size.Caption}"
                     Foreground="{StaticResource Brush.TextSecondary}" />
          <TextBlock x:Name="LampState" Text="{Binding StateText}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.TextPrimary}" />
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsOn}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="{StaticResource Brush.Normal}" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
        <Setter TargetName="LampState" Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMoving}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="{StaticResource Brush.Moving}" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter TargetName="LampState" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsFault}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="{StaticResource Brush.Alarm}" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
        <Setter TargetName="LampState" Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsUnknown}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="Transparent" />
        <Setter TargetName="LampDash" Property="Visibility" Value="Visible" />
        <Setter TargetName="LampState" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--
    位置窗的一行（最终稿 5.1）：高 76，轴名 + 用途，机床坐标 L1 54 px 右对齐。
    手持盒选中的轴整行青底、写"◀"——手轮现在摇的是谁一眼可见。
  -->
  <DataTemplate x:Key="AxisReadoutTemplate">
    <Border x:Name="Row" Height="76" Padding="14,0" Margin="0,0,0,2" Background="{StaticResource Brush.Surface}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="{x:Static ctl:LayoutProfile.AxisReadoutLabelWidth}" Margin="0,0,8,0">
          <TextBlock Text="{Binding AxisName}" FontFamily="{StaticResource Font.Mono}" FontWeight="Bold"
                     FontSize="{StaticResource Size.Secondary}" Width="70" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RoleText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Marker" DockPanel.Dock="Right" Text="&#x25C0;" FontSize="{StaticResource Size.DataRow}"
                   Width="34" TextAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
        <!-- 读数是大字：列窄（紧凑档位）时整体缩小，不切掉数字。 -->
        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Measurement}" Foreground="{StaticResource Brush.TextPrimary}" />
        </Viewbox>
      </DockPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsPendantSelected}" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.FocusField}" />
        <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--
    手动磨削页上一格会马上影响机床的值（最终稿 4.5、5.1）：点选（青底）、再点弹数字键盘；
    改了先标红，对话行问一句，竖键 8 确认才写入；倍率格旁有 −5 / +5 大键。
  -->
  <DataTemplate x:Key="SetpointTemplate">
    <DockPanel Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Top" Text="{Binding Label}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
      <Button DockPanel.Dock="Right" Content="+5" Command="{Binding StepUpCommand}" Style="{StaticResource SoftKeyButton}"
              Width="64" Height="56" Margin="6,0,0,0" FontWeight="Bold"
              Visibility="{Binding HasStep, Converter={StaticResource BoolToVisibility}}" />
      <Button DockPanel.Dock="Right" Content="&#x2212;5" Command="{Binding StepDownCommand}" Style="{StaticResource SoftKeyButton}"
              Width="64" Height="56" Margin="6,0,0,0" FontWeight="Bold"
              Visibility="{Binding HasStep, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0,0,0" />
      <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
               Style="{StaticResource ValueTextBox}"
               HorizontalContentAlignment="Right"
               ctl:TouchInput.Caption="{Binding Label}"
               ctl:TouchInput.Hint="{Binding HintText}"
               ctl:TouchInput.Minimum="{Binding Minimum}"
               ctl:TouchInput.Maximum="{Binding Maximum}"
               ctl:TouchInput.Decimals="{Binding Decimals}"
               ctl:TouchInput.IsPending="{Binding IsPending}" />
    </DockPanel>
  </DataTemplate>

  <!-- 状态带上的一格文字：小字标签在上，值在下。 -->
  <!-- 辅助功能块的小灯（一组一行）：名字写在灯里，绿 到位/开 · 灰 关 · 橙 动作中 · 红 故障 · 虚框 读不到。 -->
  <DataTemplate x:Key="StatusLampCompactTemplate">
    <!-- 文字放在填色的 Border 里面（而不是并排叠放），对比度检查与读屏都认得出它的底色。 -->
    <Grid Margin="0,0,6,0" MinWidth="78" Height="28" ToolTip="{Binding StateText}">
      <Rectangle x:Name="LampDash" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5"
                 StrokeDashArray="3 2" Visibility="Collapsed" />
      <Border x:Name="LampFill" Background="{StaticResource Brush.StepIdle}" CornerRadius="2">
        <TextBlock x:Name="LampLabel" Text="{Binding Label}" FontSize="{StaticResource Size.Caption}" Margin="8,0"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsOn}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="{StaticResource Brush.Normal}" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMoving}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="{StaticResource Brush.Moving}" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsFault}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="{StaticResource Brush.Alarm}" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.OnCurrentStep}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsUnknown}" Value="True">
        <Setter TargetName="LampFill" Property="Background" Value="Transparent" />
        <Setter TargetName="LampDash" Property="Visibility" Value="Visible" />
        <Setter TargetName="LampLabel" Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="StatusFieldTemplate">
    <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Label}" FontSize="{StaticResource Size.Caption}" Foreground="{StaticResource Brush.TextSecondary}" />
      <TextBlock x:Name="FieldValue" Text="{Binding ValueText}" FontSize="{StaticResource Size.Body}" FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.TextPrimary}" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsMonospaced}" Value="True">
        <Setter TargetName="FieldValue" Property="FontFamily" Value="{StaticResource Font.Mono}" />
      </DataTrigger>
      <!-- 状态带的 X、Z：L2 32 px（最终稿 F1，原来 18 px） -->
      <DataTrigger Binding="{Binding IsPrimary}" Value="True">
        <Setter TargetName="FieldValue" Property="FontSize" Value="{StaticResource Size.Secondary}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
