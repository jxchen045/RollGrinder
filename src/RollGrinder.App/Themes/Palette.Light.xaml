<!--
  方案B 浅色高对比。色值取自 docs/design/配色与字号规范.png 与各设计稿。
  换方案（A 深色工业 / C 中性灰）只需替换本文件：色位键名三套通用。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 语义色位（三套配色通用的键名） -->
  <Color x:Key="Color.Background">#E9ECF0</Color>
  <Color x:Key="Color.Surface">#FFFFFF</Color>
  <Color x:Key="Color.Divider">#C5CAD2</Color>
  <Color x:Key="Color.Accent">#15507F</Color>
  <Color x:Key="Color.CurrentStep">#B3241C</Color>
  <Color x:Key="Color.NextStep">#F6D24A</Color>
  <Color x:Key="Color.Normal">#1F7A4D</Color>

  <!-- 方案B 的派生色位 -->
  <Color x:Key="Color.AccentDark">#0F4370</Color>
  <Color x:Key="Color.HeaderFill">#F3F5F8</Color>
  <Color x:Key="Color.GridLine">#D8DDE4</Color>
  <Color x:Key="Color.TextPrimary">#16191E</Color>
  <Color x:Key="Color.TextSecondary">#4A5461</Color>
  <Color x:Key="Color.TextMuted">#6B7581</Color>
  <Color x:Key="Color.OnAccent">#FFFFFF</Color>
  <Color x:Key="Color.OnAccentMuted">#B9D4EA</Color>
  <Color x:Key="Color.ButtonBorder">#B6BCC6</Color>
  <Color x:Key="Color.FunctionBar">#DDE2E8</Color>
  <Color x:Key="Color.NormalFill">#E2F2E9</Color>
  <Color x:Key="Color.SelectionFill">#E3EDF6</Color>
  <Color x:Key="Color.RowAlternate">#F3F7FA</Color>
  <Color x:Key="Color.PlotBackground">#FBFCFD</Color>
  <Color x:Key="Color.PlotGridMinor">#E4E8ED</Color>
  <Color x:Key="Color.Reference">#8D97A3</Color>
  <Color x:Key="Color.WarningFill">#8A5A00</Color>

  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentDark" Color="{StaticResource Color.AccentDark}" />
  <SolidColorBrush x:Key="Brush.CurrentStep" Color="{StaticResource Color.CurrentStep}" />
  <SolidColorBrush x:Key="Brush.NextStep" Color="{StaticResource Color.NextStep}" />
  <SolidColorBrush x:Key="Brush.Normal" Color="{StaticResource Color.Normal}" />
  <SolidColorBrush x:Key="Brush.HeaderFill" Color="{StaticResource Color.HeaderFill}" />
  <SolidColorBrush x:Key="Brush.GridLine" Color="{StaticResource Color.GridLine}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
  <SolidColorBrush x:Key="Brush.OnAccentMuted" Color="{StaticResource Color.OnAccentMuted}" />
  <SolidColorBrush x:Key="Brush.ButtonBorder" Color="{StaticResource Color.ButtonBorder}" />
  <SolidColorBrush x:Key="Brush.FunctionBar" Color="{StaticResource Color.FunctionBar}" />
  <SolidColorBrush x:Key="Brush.NormalFill" Color="{StaticResource Color.NormalFill}" />
  <SolidColorBrush x:Key="Brush.SelectionFill" Color="{StaticResource Color.SelectionFill}" />
  <SolidColorBrush x:Key="Brush.RowAlternate" Color="{StaticResource Color.RowAlternate}" />
  <SolidColorBrush x:Key="Brush.PlotBackground" Color="{StaticResource Color.PlotBackground}" />
  <SolidColorBrush x:Key="Brush.PlotGridMinor" Color="{StaticResource Color.PlotGridMinor}" />
  <SolidColorBrush x:Key="Brush.Reference" Color="{StaticResource Color.Reference}" />
  <SolidColorBrush x:Key="Brush.WarningFill" Color="{StaticResource Color.WarningFill}" />
  <SolidColorBrush x:Key="Brush.StepIdle" Color="{StaticResource Color.HeaderFill}" />
  <SolidColorBrush x:Key="Brush.OnCurrentStep" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.OnNextStep" Color="#3A2F00" />

</ResourceDictionary>
