<!--
  字号的值在 Layout.Standard.xaml / Layout.Compact.xaml（按档位）。
  字号层级（界面最终稿 F1、4.2）：
  L1 主读数 54（Size.Measurement：手动磨削的 X、X1、Z、U，测量直径，自动页实测直径，对中两端之差）；
  L2 次读数 32（Size.Secondary：砂轮、头架、拖板实际值，自动页状态带 X、Z）；
  L3 数值格、表格 24（Size.DataRow）；正文、标签、软键 19（Size.Body）；最小 15（Size.Caption，只用于辅助信息）。

  两套字体都**编译进程序集**（src/RollGrinder.App/Fonts/，OFL 授权）：
  中文 Noto Sans SC，数字与位置值 IBM Plex Mono（Regular / Medium / SemiBold 三个字重）。
  嵌进来是为了让显示不因工控机装了什么而异——换一台机器、换一版 Windows 镜像，
  字宽字距都一样，数字列不会忽然对不齐。

  后面仍留着 Microsoft YaHei UI 与 Consolas 作为兜底：万一资源加载不出来，
  界面还是可读的，不会变成方块。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="Font.Sans">pack://application:,,,/Fonts/#Noto Sans SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
  <FontFamily x:Key="Font.Mono">pack://application:,,,/Fonts/#IBM Plex Mono, Consolas, Cascadia Mono</FontFamily>


  <!-- 主测量值：实测直径这类"一眼要看到"的数 -->
  <Style x:Key="Text.Measurement" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Measurement}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
  </Style>

  <!-- L2 次读数：实际值、状态带坐标 -->
  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Secondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Text.Parameter" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Parameter}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Text.DataRow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Size.DataRow}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="{StaticResource Size.Label}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Text.CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="{StaticResource Size.CardTitle}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
