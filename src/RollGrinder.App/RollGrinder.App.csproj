<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RollGrinder.App</RootNamespace>
    <AssemblyName>RollGrinder.App</AssemblyName>
    <StartupObject>RollGrinder.App.Program</StartupObject>
    <!--
      架构约束：App 只允许使用 Contracts / Core / Nc / Data / Composition 的类型。
      Device 与 Sim 的实现类型是 internal，只对 Composition 可见，App 编译期就用不到；
      运行期这两个程序集仍需随 App 发布，因此此处不能关掉传递引用。
      RollGrinder.Integration.Tests 里的架构测试会检查 App 程序集确实没有引用它们。
    -->
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 自带 Main，改由 Program.cs 启动，App.xaml 作为普通 Page 编译。 -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RollGrinder.Contracts\RollGrinder.Contracts.csproj" />
    <ProjectReference Include="..\RollGrinder.Core\RollGrinder.Core.csproj" />
    <ProjectReference Include="..\RollGrinder.Nc\RollGrinder.Nc.csproj" />
    <ProjectReference Include="..\RollGrinder.Data\RollGrinder.Data.csproj" />
    <ProjectReference Include="..\RollGrinder.Composition\RollGrinder.Composition.csproj" />
    <ProjectReference Include="..\RollGrinder.Services\RollGrinder.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup Label="部署：config/*.sample.json 随程序发布，升级时不覆盖现场 config/*.json">
    <None Include="..\..\config\*.sample.json" Link="config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
